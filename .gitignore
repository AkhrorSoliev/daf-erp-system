node_modules
.next
.DS_Store
.env*
.vercel
*.tsbuildinfo
next-env.d.ts
client/public/*.dmg

# Credentials / secrets
*.pem
credentials.json
service-account*.json

# Server
server/dist
server/generated
server/audit-output/
# NOTE: the generated-report dir is ignored via server/.gitignore as the
# anchored pattern `/reports/`. A `server/reports/` pattern here made
# `railway up` (run from server/) strip the `server/` prefix to a bare,
# UNANCHORED `reports/`, which also excluded the source dir server/src/reports/
# from the upload and broke the build (TS2307 on every `../reports/*` import).

# Generated Excel reports / scratch audio binaries (not source — regenerated)
/audios/

# Editor / agent runtime state
.claude/scheduled_tasks.lock
.claude/review-output/
.windsurf/
# One-off diagnostic / probe scripts written during debugging sessions.
# Convention: a leading underscore marks a throwaway script. Reusable audit
# tooling keeps its plain name (audit-*, diag-*, verify-*) and IS committed.
server/scripts/_*.ts
server/.tmp-*
server/*.xlsx
server/scripts/backups/
