generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  FROZEN
  GRADUATED
  EXPELLED
  ARCHIVED
}

enum SmsMessageType {
  AUTO
  MANUAL
}

enum SmsMessageStatus {
  SENT
  FAILED
}

enum GroupStatus {
  FORMING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
  ARCHIVED
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  FROZEN
  COMPLETED
  DROPPED
  TRANSFERRED
}

enum HolidayStatus {
  ACTIVE
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum EntityAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  RESTORE
}

enum AssigneeStatus {
  PENDING
  SEEN
  DONE
}

enum NotificationType {
  COMMENT
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DELETED
  TASK_UPDATED
  TASK_REMINDER
  SYSTEM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AiUseCaseType {
  STUDENT_CHAT
  STATISTICS
  VOCABULARY
  TEST_GENERATION
}

// ===== FINANCIAL SYSTEM ENUMS =====

enum PaymentMethod {
  CASH
  PAYME
  CLICK
  UZUM
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  REVERSED
}

enum TransactionType {
  PAYMENT
  LESSON_DEDUCTION
  REFUND
  SALARY_ACCRUAL
  SALARY_PAYMENT
  EXPENSE
  ADJUSTMENT
  TAX
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SalaryType {
  PERCENTAGE
  FIXED_PER_STUDENT
  FIXED_MONTHLY
}

enum SalaryPaymentStatus {
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  TEACHER_ADVANCE
  OTHER
}

enum PaymentSource {
  ADMIN_MANUAL
  STUDENT_PORTAL
  GATEWAY_WEBHOOK
  MANUAL_ATTACH
}

model Role {
  id   Int    @id
  name String @unique

  users UserRole[]
}

model User {
  id             Int        @id @default(autoincrement())
  firstName      String
  lastName       String
  phone          String?
  photo          String?
  gender         Gender?
  balance        Int        @default(0)
  login          String?
  password       String?
  isActive       Boolean    @default(true)
  status         UserStatus @default(ACTIVE)
  telegramChatId String?
  companyId      Int
  company        Company    @relation(fields: [companyId], references: [id])
  mainBranch     Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("DeletedByUser", fields: [deletedById], references: [id])
  deletedUsers    User[]    @relation("DeletedByUser")
  deletionBatchId String?

  roles         UserRole[]
  branches      UserBranch[]
  groups        Group[]        @relation("StudentGroups")
  groupTeachers GroupTeacher[] @relation("GroupTeachers")

  deletedBranches    Branch[]           @relation("BranchDeletedBy")
  deletedRooms       Room[]             @relation("RoomDeletedBy")
  deletedCourses     Course[]           @relation("CourseDeletedBy")
  deletedStudents    Student[]          @relation("StudentDeletedBy")
  deletedLeads       Lead[]             @relation("LeadDeletedBy")
  deletedGroups      Group[]            @relation("GroupDeletedBy")
  deletedEnrollments Enrollment[]       @relation("EnrollmentDeletedBy")
  deletedHolidays    Holiday[]          @relation("HolidayDeletedBy")
  statusChanges      StatusHistory[]    @relation("StatusChangedBy")
  entityChanges      EntityHistory[]    @relation("EntityHistoryChangedBy")
  comments           Comment[]          @relation("CommentAuthor")
  commentAssignees   CommentAssignee[]  @relation("CommentAssignees")
  notifications      Notification[]     @relation("UserNotifications")
  pushSubscriptions  PushSubscription[] @relation("UserPushSubscriptions")
  sentSmsMessages    SmsMessage[]       @relation("SmsSender")
  markedAttendances  Attendance[]       @relation("AttendanceMarkedBy")
  student            Student?           @relation("StudentUser")
  aiConversations    AiConversation[]   @relation("UserAiConversations")

  // Financial relations (employee salary — works for all roles)
  salaryConfigs       EmployeeSalaryConfig[] @relation("UserSalaryConfigs")
  salaryPayments      SalaryPayment[]        @relation("UserSalaryPayments")
  salaryAccruals      SalaryAccrual[]        @relation("UserSalaryAccruals")
  teacherTransactions Transaction[]          @relation("TeacherTransactions")

  // Financial relations (operator)
  receivedPayments      Payment[]       @relation("PaymentReceivedBy")
  performedTransactions Transaction[]   @relation("TransactionPerformedBy")
  processedRefunds      Refund[]        @relation("RefundProcessedBy")
  paidSalaries          SalaryPayment[] @relation("SalaryPaidBy")
  createdExpenses       Expense[]       @relation("ExpenseCreatedBy")
  deletedExpenses       Expense[]       @relation("ExpenseDeletedBy")
  relatedExpenses       Expense[]       @relation("ExpenseRelatedUser")
  deletedContracts      Contract[]      @relation("ContractDeletedBy")

  @@index([deletedAt])
  @@index([status])
}

model UserRole {
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserBranch {
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Branch {
  id                Int          @id
  name              String
  address           String?
  phone             String?
  isActive          Boolean      @default(true)
  status            BranchStatus @default(ACTIVE)
  startOfWorkingDay String?
  endOfWorkingDay   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("BranchDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  users           UserBranch[]
  studentBranches StudentBranch[]
  rooms           Room[]
  groups          Group[]
  courses         Course[]

  @@index([deletedAt])
  @@index([status])
}

model Room {
  id        String     @id @default(uuid())
  name      String
  capacity  Int?
  status    RoomStatus @default(ACTIVE)
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  companyId Int?
  company   Company?   @relation(fields: [companyId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("RoomDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groups Group[]

  @@index([deletedAt])
  @@index([status])
}

model Course {
  id                 String       @id @default(uuid())
  name               String
  description        String?
  price              Int
  lessonPaymentCount Int          @default(12)
  courseDuration     Int?
  lessonDuration     Int?
  lessonMinutes      Int?
  isActive           Boolean      @default(true)
  status             CourseStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("CourseDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groups    Group[]
  contracts Contract[]

  @@index([deletedAt])
  @@index([status])
}

model Student {
  id             Int           @id @default(autoincrement())
  firstName      String
  lastName       String
  phone          String
  extraPhone     String?
  parentPhone    String?
  parentName     String?
  telegram       String?
  telegramChatId String?
  gender         Gender?
  dateOfBirth    DateTime?
  photo          String?
  comment        String?
  balance        Int           @default(0)
  placeOfStudy   String?
  address        String?
  passportSeries String?
  isActive       Boolean       @default(true)
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("StudentDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  userId Int?  @unique
  user   User? @relation("StudentUser", fields: [userId], references: [id])

  enrollments     Enrollment[]
  branches        StudentBranch[]
  smsMessages     SmsMessage[]
  attendances     Attendance[]
  aiConversations AiConversation[] @relation("StudentAiConversations")

  // Financial relations
  payments     Payment[]
  transactions Transaction[] @relation("StudentTransactions")
  contracts    Contract[]
  refunds      Refund[]

  @@index([deletedAt])
  @@index([status])
}

model StudentBranch {
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([studentId, branchId])
}

model Lead {
  id          String     @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  gender      Gender?
  telegram    String?
  parentPhone String?
  parentName  String?
  status      String     @default("new")
  statusEnum  LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  @@index([deletedAt])
  @@index([statusEnum])
}

model Group {
  id              String      @id @default(uuid())
  name            String
  groupNumber     Int?
  level           String?
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id])
  branchId        Int
  branch          Branch      @relation(fields: [branchId], references: [id])
  roomId          String?
  room            Room?       @relation(fields: [roomId], references: [id])
  companyId       Int?
  company         Company?    @relation(fields: [companyId], references: [id])
  days            String?
  exactDays       String[]
  lessonStartTime String?
  lessonEndTime   String?
  lessonMinutes   Int?
  status          Int         @default(2)
  statusEnum      GroupStatus @default(FORMING)
  comment         String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("GroupDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  teachers    GroupTeacher[]
  students    User[]         @relation("StudentGroups")
  enrollments Enrollment[]
  attendances Attendance[]

  // Financial relations
  contracts     Contract[]
  salaryConfigs EmployeeSalaryConfig[]

  @@unique([name, branchId])
  @@index([deletedAt])
  @@index([statusEnum])
}

model GroupTeacher {
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId Int
  teacher   User   @relation("GroupTeachers", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([groupId, teacherId])
}

model Enrollment {
  id        String           @id @default(uuid())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id])
  groupId   String
  group     Group            @relation(fields: [groupId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?
  transferredToId    String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("EnrollmentDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  @@index([deletedAt])
  @@index([status])
}

model Holiday {
  id     String        @id @default(uuid())
  name   String
  date   DateTime
  status HolidayStatus @default(ACTIVE)

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("HolidayDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  @@index([deletedAt])
  @@index([status])
}

model StatusHistory {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  reason      String?
  changedById Int?
  changedBy   User?    @relation("StatusChangedBy", fields: [changedById], references: [id])
  companyId   Int?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([companyId])
}

model EntityHistory {
  id          String       @id @default(uuid())
  entityType  String
  entityId    String
  action      EntityAction
  oldValues   Json?
  newValues   Json?
  changedById Int?
  changedBy   User?        @relation("EntityHistoryChangedBy", fields: [changedById], references: [id])
  companyId   Int?
  createdAt   DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([companyId])
  @@index([createdAt])
}

model Company {
  id              Int       @id
  name            String
  subdomain       String?
  logo            String?
  phone           String?
  activatedTill   DateTime?
  customCss       String?
  customCssLead   String?
  leadSuccessText String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users       User[]
  branches    Branch[]
  students    Student[]
  courses     Course[]
  rooms       Room[]
  groups      Group[]
  comments    Comment[]
  attendances Attendance[]
}

model Comment {
  id         String        @id @default(uuid())
  entityType String
  entityId   String
  content    String
  isTask     Boolean       @default(false)
  isSystem   Boolean       @default(false)
  dueDate    DateTime?
  priority   TaskPriority?
  authorId   Int
  author     User          @relation("CommentAuthor", fields: [authorId], references: [id])
  companyId  Int
  company    Company       @relation(fields: [companyId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  assignees     CommentAssignee[]
  notifications Notification[]

  @@index([entityType, entityId])
  @@index([authorId])
  @@index([companyId])
  @@index([createdAt])
  @@index([isTask, dueDate])
}

model CommentAssignee {
  id             String         @id @default(uuid())
  commentId      String
  comment        Comment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId         Int
  user           User           @relation("CommentAssignees", fields: [userId], references: [id])
  status         AssigneeStatus @default(PENDING)
  seenAt         DateTime?
  doneAt         DateTime?
  lastRemindedAt DateTime?
  createdAt      DateTime       @default(now())

  @@unique([commentId, userId])
  @@index([userId, status])
}

model Notification {
  id                String           @id @default(uuid())
  userId            Int
  user              User             @relation("UserNotifications", fields: [userId], references: [id])
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  commentId         String?
  comment           Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)
  isRead            Boolean          @default(false)
  companyId         Int
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([companyId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SmsMessage {
  id                String           @id @default(uuid())
  studentId         Int
  student           Student          @relation(fields: [studentId], references: [id])
  content           String
  type              SmsMessageType
  status            SmsMessageStatus
  senderUserId      Int?
  senderUser        User?            @relation("SmsSender", fields: [senderUserId], references: [id])
  telegramMessageId Int?
  errorMessage      String?
  companyId         Int?
  createdAt         DateTime         @default(now())

  @@index([studentId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([status])
}

model Attendance {
  id           String           @id @default(uuid())
  groupId      String
  group        Group            @relation(fields: [groupId], references: [id])
  studentId    Int
  student      Student          @relation(fields: [studentId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  markedById   Int?
  markedBy     User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedMethod AttendanceMethod @default(MANUAL)
  companyId    Int?
  company      Company?         @relation(fields: [companyId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([groupId, studentId, date])
  @@index([groupId, date])
  @@index([studentId])
  @@index([companyId])
}

model AiConversation {
  id          String          @id @default(uuid())
  userId      Int
  user        User            @relation("UserAiConversations", fields: [userId], references: [id])
  studentId   Int?
  student     Student?        @relation("StudentAiConversations", fields: [studentId], references: [id])
  useCase     AiUseCaseType
  title       String?
  model       String          @default("gpt-4o-mini")
  totalTokens Int             @default(0)
  messages    AiChatMessage[]
  companyId   Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([studentId])
  @@index([useCase])
}

model AiChatMessage {
  id               String         @id @default(uuid())
  conversationId   String
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String
  content          String
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ===== FINANCIAL SYSTEM MODELS =====

model Payment {
  id                 String         @id @default(uuid())
  studentId          Int
  student            Student        @relation(fields: [studentId], references: [id])
  contractId         String?
  contract           Contract?      @relation(fields: [contractId], references: [id])
  amount             Int
  method             PaymentMethod
  status             PaymentStatus  @default(COMPLETED)
  source             PaymentSource  @default(ADMIN_MANUAL)
  externalId         String?
  providerFee        Int?
  providerFeePercent Float?
  receiptNumber      String?
  note               String?
  receivedById       Int?
  receivedBy         User?          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  branchId           Int?
  companyId          Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  transactions Transaction[]

  @@unique([method, externalId, companyId], name: "unique_external_payment")
  @@index([studentId])
  @@index([companyId, createdAt])
  @@index([status])
  @@index([method])
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String?

  studentId Int?
  student   Student? @relation("StudentTransactions", fields: [studentId], references: [id])
  teacherId Int?
  teacher   User?    @relation("TeacherTransactions", fields: [teacherId], references: [id])

  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  attendanceId    String?
  salaryPaymentId String?
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id])
  refundId        String?
  refund          Refund?        @relation(fields: [refundId], references: [id])
  enrollmentId    String?
  contractId      String?
  contract        Contract?      @relation(fields: [contractId], references: [id])
  expenseId       String?
  expense         Expense?       @relation(fields: [expenseId], references: [id])

  // Reversal link: points to the original transaction this one reverses.
  reversedTransactionId String?
  reversedTransaction   Transaction?  @relation("TransactionReversal", fields: [reversedTransactionId], references: [id])
  reversalEntries       Transaction[] @relation("TransactionReversal")

  // Linked salary accruals (coverage guard — B.1).
  accruals SalaryAccrual[] @relation("AccrualDeduction")

  performedById Int?
  performedBy   User?    @relation("TransactionPerformedBy", fields: [performedById], references: [id])
  branchId      Int?
  companyId     Int
  createdAt     DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([type])
  @@index([companyId, createdAt])
  @@index([branchId])
  @@index([contractId])
  @@index([expenseId])
  @@index([reversedTransactionId])
}

model Contract {
  id             String  @id @default(uuid())
  contractNumber String  @unique
  studentId      Int
  student        Student @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course  @relation(fields: [courseId], references: [id])
  groupId        String?
  group          Group?  @relation(fields: [groupId], references: [id])
  branchId       Int

  totalAmount Int
  paidAmount  Int            @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      ContractStatus @default(DRAFT)

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  signedAt     DateTime?
  signedDocUrl String?

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("ContractDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  payments     Payment[]
  refunds      Refund[]
  transactions Transaction[]

  @@index([studentId])
  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model EmployeeSalaryConfig {
  id         String     @id @default(uuid())
  userId     Int
  user       User       @relation("UserSalaryConfigs", fields: [userId], references: [id])
  groupId    String?
  group      Group?     @relation(fields: [groupId], references: [id])
  salaryType SalaryType
  value      Int
  isActive   Boolean    @default(true)
  companyId  Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, groupId])
  @@index([userId])
  @@index([companyId])
}

model SalaryAccrual {
  id              String         @id @default(uuid())
  userId          Int
  user            User           @relation("UserSalaryAccruals", fields: [userId], references: [id])
  studentId       Int
  groupId         String
  attendanceId    String
  lessonDate      DateTime       @db.Date
  amount          Int
  salaryPaymentId String?
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id])

  // Coverage link: accrual is only written when the corresponding lesson
  // deduction transaction exists (B.1). Null until backfilled or for legacy rows.
  deductionTransactionId String?
  deductionTransaction   Transaction? @relation("AccrualDeduction", fields: [deductionTransactionId], references: [id])

  companyId Int
  createdAt DateTime @default(now())

  @@unique([userId, studentId, groupId, lessonDate])
  @@index([userId, salaryPaymentId])
  @@index([companyId])
  @@index([deductionTransactionId])
}

model SalaryPayment {
  id          String              @id @default(uuid())
  userId      Int
  user        User                @relation("UserSalaryPayments", fields: [userId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  grossAmount Int
  taxAmount   Int                 @default(0)
  netAmount   Int
  status      SalaryPaymentStatus @default(CALCULATED)
  paidAt      DateTime?
  paidById    Int?
  paidBy      User?               @relation("SalaryPaidBy", fields: [paidById], references: [id])
  note        String?
  companyId   Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  transactions     Transaction[]
  accruals         SalaryAccrual[]
  settledExpenses  Expense[]       @relation("ExpenseSettledBy")

  @@index([userId])
  @@index([companyId, periodEnd])
  @@index([status])
}

model Refund {
  id               String         @id @default(uuid())
  studentId        Int
  student          Student        @relation(fields: [studentId], references: [id])
  contractId       String
  contract         Contract       @relation(fields: [contractId], references: [id])
  requestedAmount  Int
  approvedAmount   Int?
  lessonsCompleted Int
  totalLessons     Int
  deductions       Json?
  status           RefundStatus   @default(REQUESTED)
  refundMethod     PaymentMethod?
  reason           String?
  processedById    Int?
  processedBy      User?          @relation("RefundProcessedBy", fields: [processedById], references: [id])
  processedAt      DateTime?
  dueDate          DateTime?
  companyId        Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transactions Transaction[]

  @@index([studentId])
  @@index([contractId])
  @@index([companyId])
  @@index([status])
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  amount      Int
  description String
  date        DateTime        @db.Date
  branchId    Int?
  receiptUrl  String?
  createdById Int
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  // Optional link to an employee — used by TEACHER_ADVANCE to bind the
  // advance to the recipient so it can be netted against future salary.
  relatedUserId Int?
  relatedUser   User? @relation("ExpenseRelatedUser", fields: [relatedUserId], references: [id])

  // Settlement link: when a TEACHER_ADVANCE is netted out of a salary run,
  // this points at the SalaryPayment that absorbed it so the next run
  // skips it. NULL means "still outstanding."
  settledBySalaryPaymentId String?
  settledBySalaryPayment   SalaryPayment? @relation("ExpenseSettledBy", fields: [settledBySalaryPaymentId], references: [id])

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  transactions Transaction[]

  @@index([companyId, date])
  @@index([category])
  @@index([deletedAt])
  @@index([relatedUserId])
}

// ===== TAX CONFIGURATION =====

// Per-company tax rates applied during salary calculation and refund processing.
// Default 12% reflects Uzbekistan ASOT (Aholidan Soliq Olishning Oliy Tartibi).
model CompanyTaxConfig {
  id            String   @id @default(cuid())
  companyId     Int      @unique
  salaryTaxRate Float    @default(12.0)
  refundTaxRate Float    @default(0.0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== PAYMENT GATEWAY EVENT LOG =====

// Raw webhook payload log for Payme/Click/Uzum. Written before any payment
// processing so we can debug, dispute, replay or detect duplicates regardless
// of whether the payload was eventually accepted.
model PaymentGatewayEvent {
  id             String        @id @default(uuid())
  companyId      Int
  provider       PaymentMethod
  externalId     String
  eventType      String
  payload        Json
  signatureValid Boolean       @default(false)
  processed      Boolean       @default(false)
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime      @default(now())

  @@index([companyId, provider, createdAt])
  @@index([externalId])
  @@index([processed])
}
