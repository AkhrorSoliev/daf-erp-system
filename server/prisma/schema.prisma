generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

model Role {
  id    Int    @id
  name  String @unique

  users UserRole[]
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  phone          String?
  photo          String?
  gender         Gender?
  balance        Int       @default(0)
  login          String?
  password       String?
  isActive       Boolean   @default(true)
  telegramChatId String?
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id])
  mainBranch     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("DeletedByUser", fields: [deletedById], references: [id])
  deletedUsers    User[]    @relation("DeletedByUser")
  deletionBatchId String?

  roles         UserRole[]
  branches      UserBranch[]
  groups        Group[]        @relation("StudentGroups")
  teacherGroups Group[]        @relation("TeacherGroups")

  deletedBranches    Branch[]     @relation("BranchDeletedBy")
  deletedRooms       Room[]       @relation("RoomDeletedBy")
  deletedCourses     Course[]     @relation("CourseDeletedBy")
  deletedStudents    Student[]    @relation("StudentDeletedBy")
  deletedLeads       Lead[]       @relation("LeadDeletedBy")
  deletedGroups      Group[]      @relation("GroupDeletedBy")
  deletedEnrollments Enrollment[] @relation("EnrollmentDeletedBy")
  deletedHolidays    Holiday[]    @relation("HolidayDeletedBy")

  @@index([deletedAt])
}

model UserRole {
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserBranch {
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Branch {
  id        Int      @id
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("BranchDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  users     UserBranch[]
  rooms     Room[]
  groups    Group[]
  courses   Course[]

  @@index([deletedAt])
}

model Room {
  id        String   @id @default(uuid())
  name      String
  capacity  Int?
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("RoomDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groups Group[]

  @@index([deletedAt])
}

model Course {
  id             String   @id @default(uuid())
  name           String
  description    String?
  price          Int
  courseDuration Int?
  lessonDuration Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("CourseDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groups Group[]

  @@index([deletedAt])
}

model Student {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  phone          String
  extraPhone     String?
  parentPhone    String?
  parentName     String?
  telegram       String?
  telegramChatId String?
  gender         Gender?
  avatar         String?
  placeOfStudy   String?
  address        String?
  passportSeries String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("StudentDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  enrollments Enrollment[]

  @@index([deletedAt])
}

model Lead {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  gender      Gender?
  telegram    String?
  parentPhone String?
  parentName  String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  @@index([deletedAt])
}

model Group {
  id        String    @id @default(uuid())
  name      String
  courseId   String
  course    Course    @relation(fields: [courseId], references: [id])
  teacherId Int
  teacher   User      @relation("TeacherGroups", fields: [teacherId], references: [id])
  branchId  Int
  branch    Branch    @relation(fields: [branchId], references: [id])
  roomId    String?
  room      Room?     @relation(fields: [roomId], references: [id])
  startDate DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("GroupDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  students    User[]       @relation("StudentGroups")
  enrollments Enrollment[]

  @@index([deletedAt])
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now())

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("EnrollmentDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  @@index([deletedAt])
}

model Holiday {
  id   String   @id @default(uuid())
  name String
  date DateTime

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("HolidayDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  @@index([deletedAt])
}

model Company {
  id                Int       @id
  name              String
  subdomain         String?
  logo              String?
  phone             String?
  activatedTill     DateTime?
  startOfWorkingDay String?
  endOfWorkingDay   String?
  customCss         String?
  customCssLead     String?
  leadSuccessText   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users    User[]
  branches Branch[]
  courses  Course[]
  rooms    Room[]
}
