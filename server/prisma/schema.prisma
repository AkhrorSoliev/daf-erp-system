}

model Attendance {
  id             String              @id @default(uuid())
  groupId        String
  group          Group               @relation(fields: [groupId], references: [id])
  studentId      Int
  student        Student             @relation(fields: [studentId], references: [id])
  date           DateTime            @db.Date
  status         AttendanceStatus
  note           String?
  markedById     Int?
  markedBy       User?               @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedMethod   AttendanceMethod    @default(MANUAL)
  // Set when this attendance row exists for a lesson that was later
  // cancelled. The status is forced to EXCUSED so existing biller/stat
  // queries keep working — cancellation is metadata via this link, not a
  // new enum value on AttendanceStatus.
  cancellationId String?
  cancellation   LessonCancellation? @relation(fields: [cancellationId], references: [id])
  companyId      Int
  company        Company             @relation(fields: [companyId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([groupId, studentId, date])
  @@index([groupId, date])
  @@index([studentId])
  @@index([companyId])
  @@index([cancellationId])
}

// Admin pre-marks a student as not-coming BEFORE the lesson is taken (e.g. the
// student calls in the morning for an afternoon lesson). This is intent, not a
// lesson record — it deliberately is NOT an Attendance row so it neither bills
// nor locks the teacher out of taking attendance later. When the full roster is
// finally saved, the matching planned rows are stamped `consumedAt`. Same
// "side-table overlay" pattern as LessonCancellation / LessonReschedule.
enum PlannedAbsenceKind {
  SABABLI // excused — uzrli sabab
  SABABSIZ // unexcused — umuman kelmaydi (lekin oldindan ogohlantirgan)
}

model PlannedAbsence {
  id          String             @id @default(uuid())
  groupId     String
  group       Group              @relation(fields: [groupId], references: [id])
  studentId   Int
  student     Student            @relation(fields: [studentId], references: [id])
  date        DateTime           @db.Date
  kind        PlannedAbsenceKind
  note        String?
  createdById Int?
  createdBy   User?              @relation("PlannedAbsenceCreatedBy", fields: [createdById], references: [id])
  // Set when the lesson's full attendance is finally saved — marks the pre-mark
  // as merged into the real Attendance row so it stops pre-filling the form.
  consumedAt  DateTime?
  companyId   Int
  company     Company            @relation(fields: [companyId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([groupId, studentId, date])
  @@index([groupId, date])
  @@index([companyId, date])
  @@index([studentId])
}

enum PaymentPromiseStatus {
  OPEN // o'quvchi to'lov va'da berdi, hali hal bo'lmagan
  KEPT // to'lov kelib balans tiklandi — va'da bajarildi
  BROKEN // va'da sanasi o'tdi, o'quvchi hali ham qarzdor
  CANCELLED // admin qo'lda bekor qildi
}

// A debtor's commitment to pay by a date. Recorded by an admin/cashier after
// contacting the student. Auto-resolves to KEPT when a payment restores the
// balance; the daily cron flips it to BROKEN (and notifies branch admins) if
// the date passes while the student is still in debt. One OPEN promise per
// student (partial unique index, mirrors the INITIAL_BALANCE precedent).
model PaymentPromise {
  id               String               @id @default(uuid())
  studentId        Int
  student          Student              @relation(fields: [studentId], references: [id])
  promisedAmount   Int? // so'm; nullable for "to'layman" promises without a figure
  // Full timestamp, NOT @db.Date — avoids Tashkent-offset truncation breaking
  // `promiseDate < now` range comparisons (same lesson as creditPeriodDate).
  promiseDate      DateTime
  comment          String?
  status           PaymentPromiseStatus @default(OPEN)
  // Snapshot of Student.balance when the promise was made, so "kept" can be
  // judged against the state at promise time.
  balanceAtPromise Int
  // Idempotency marker for the daily reminder cron (mirrors
  // CommentAssignee.lastRemindedAt) — set when the overdue reminder fired.
  reminderFiredAt  DateTime?
  resolvedAt       DateTime?
  resolvedById     Int?
  resolvedBy       User?                @relation("PaymentPromiseResolvedBy", fields: [resolvedById], references: [id])
  createdById      Int
  createdBy        User                 @relation("PaymentPromiseCreatedBy", fields: [createdById], references: [id])
  branchId         Int? // for Branch Director scoping on /outreach
  companyId        Int
  company          Company              @relation(fields: [companyId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([studentId])
  @@index([companyId, status])
  @@index([status, promiseDate])
  @@index([branchId])
}

enum CallReason {
  ABSENCE // darsga kelmagani uchun (bugungi kelmaganlar)
  DEBT // qarz / to'lov sanasi uchun
  REMOVAL // ko'p dars qoldirgani (chiqarish navbati) uchun
  OTHER
}

enum CallOutcome {
  ANSWERED // gaplashildi
  NO_ANSWER // javob bermadi
  PROMISED // LEGACY: eski "keladi / to'laydi dedi" — endi WILL_COME/WILL_PAY ga ajratildi
  WILL_COME // keladi dedi
  WILL_PAY // to'laydi dedi — ixtiyoriy to'lov sanasi belgilanadi
  LEFT // tashlab ketdi
}

// A logged phone call an admin made to a student from the /outreach (Aloqa
// markazi) workflow. Unlike the old Comment-task flow, this records a call that
// already happened — who called, the reason (which list it came from), the
// outcome, and an optional note. Powers the "Qo'ng'iroq tarixi" tab and the
// student profile call-history tab. Student-only (outreach never targets Leads).
model CallLog {
  id         String      @id @default(uuid())
  studentId  Int
  student    Student     @relation(fields: [studentId], references: [id])
  reason     CallReason
  outcome    CallOutcome
  note       String?
  // Optional "call again later" date for non-payment outcomes
  // (NO_ANSWER / ANSWERED / WILL_COME). Distinct from a PaymentPromise — it is
  // just a callback reminder and never fires the promise-broken cron/notification.
  followUpAt DateTime?
  calledById Int
  calledBy   User        @relation("CallLogCalledBy", fields: [calledById], references: [id])
  branchId   Int? // for Branch Director scoping on /outreach
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([studentId])
  @@index([companyId, createdAt])
  @@index([companyId, followUpAt])
  @@index([branchId])
}

model AiConversation {
  id          String          @id @default(uuid())
  userId      Int
  user        User            @relation("UserAiConversations", fields: [userId], references: [id])
  studentId   Int?
  student     Student?        @relation("StudentAiConversations", fields: [studentId], references: [id])
  useCase     AiUseCaseType
  chatMode    String?
  title       String?
  model       String          @default("gpt-4o-mini")
  totalTokens Int             @default(0)
  messages    AiChatMessage[]
  companyId   Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([studentId])
  @@index([useCase])
}

model AiChatMessage {
  id               String         @id @default(uuid())
  conversationId   String
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String
  content          String
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ===== FINANCIAL SYSTEM MODELS =====

model Payment {
  id                 String        @id @default(uuid())
  studentId          Int
  student            Student       @relation(fields: [studentId], references: [id])
  contractId         String?
  contract           Contract?     @relation(fields: [contractId], references: [id])
  amount             Int
  method             PaymentMethod
  revenueType        RevenueType?  @default(TUITION)
  status             PaymentStatus @default(COMPLETED)
  source             PaymentSource @default(ADMIN_MANUAL)
  externalId         String?
  providerFee        Int?
  providerFeePercent Float?
  receiptNumber      String?
  note               String?
  receivedById       Int?
  receivedBy         User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  branchId           Int?
  companyId          Int
  receiptCode        String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  transactions Transaction[]

  @@unique([method, externalId, companyId], name: "unique_external_payment")
  @@index([studentId])
  @@index([companyId, createdAt])
  @@index([status])
  @@index([method])
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String?
  // Free-form structured audit. LESSON_CONSUMPTION rows carry
  // { perLessonCost, lessonMode } so a single row tells the whole story.
  // LESSON_DEDUCTION rows tag themselves with { lessonMode: FULL_CYCLE | PARTIAL }.
  metadata      Json?

  studentId Int?
  student   Student? @relation("StudentTransactions", fields: [studentId], references: [id])
  teacherId Int?
  teacher   User?    @relation("TeacherTransactions", fields: [teacherId], references: [id])

  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  attendanceId    String?
  salaryPaymentId String?
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id])
  refundId        String?
  refund          Refund?        @relation(fields: [refundId], references: [id])
  enrollmentId    String?
  contractId      String?
  contract        Contract?      @relation(fields: [contractId], references: [id])
  expenseId       String?
  expense         Expense?       @relation(fields: [expenseId], references: [id])

  // Reversal link: points to the original transaction this one reverses.
  reversedTransactionId String?
  reversedTransaction   Transaction?  @relation("TransactionReversal", fields: [reversedTransactionId], references: [id])
  reversalEntries       Transaction[] @relation("TransactionReversal")

  // Set on an *original* row when another row reverses it. Lets idempotency
  // filters and partial unique indexes select "still-active" rows in a
  // single column without sub-queries — without this, the LESSON_CONSUMPTION
  // idempotency check finds reversed originals and incorrectly skips
  // re-billing on ABSENT→PRESENT transitions.
  reversedAt   DateTime?
  reversedById Int?
  reversedBy   User?     @relation("TransactionReversedBy", fields: [reversedById], references: [id])

  // Linked salary accruals (coverage guard — B.1).
  accruals SalaryAccrual[] @relation("AccrualDeduction")

  performedById Int?
  performedBy   User?    @relation("TransactionPerformedBy", fields: [performedById], references: [id])
  branchId      Int?
  companyId     Int
  createdAt     DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([type])
  @@index([companyId, createdAt])
  @@index([branchId])
  @@index([contractId])
  @@index([expenseId])
  @@index([reversedTransactionId])
}

model Contract {
  id             String  @id @default(uuid())
  contractNumber String  @unique
  studentId      Int
  student        Student @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course  @relation(fields: [courseId], references: [id])
  groupId        String?
  group          Group?  @relation(fields: [groupId], references: [id])
  branchId       Int

  totalAmount Int
  paidAmount  Int            @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      ContractStatus @default(DRAFT)

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  signedAt     DateTime?
  signedDocUrl String?

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("ContractDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  payments         Payment[]
  refunds          Refund[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]

  @@index([studentId])
  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model EmployeeSalaryConfig {
  id         String     @id @default(uuid())
  userId     Int
  user       User       @relation("UserSalaryConfigs", fields: [userId], references: [id])
  groupId    String?
  group      Group?     @relation(fields: [groupId], references: [id])
  salaryType SalaryType
  value      Int
  isActive   Boolean    @default(true)
  companyId  Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  versions EmployeeSalaryConfigVersion[]

  @@unique([userId, groupId])
  @@index([userId])
  @@index([companyId])
}

// SCD2 history for EmployeeSalaryConfig. Every create/update on the parent
// closes the previous version (sets effectiveTo) and inserts a new row.
// Salary accruals look up the version active on the lesson date so a rate
// change applies to lessons after `effectiveFrom` only — past lessons keep
// their original rate.
model EmployeeSalaryConfigVersion {
  id            String               @id @default(uuid())
  configId      String
  config        EmployeeSalaryConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  salaryType    SalaryType
  value         Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  changedById   Int?
  changedBy     User?                @relation("SalaryConfigVersionChangedBy", fields: [changedById], references: [id])
  companyId     Int
  createdAt     DateTime             @default(now())

  accruals SalaryAccrual[]

  @@index([configId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@index([companyId])
}

// Configurable salary period (cycle start day). Default 8th→7th, but CEO
// can change. SCD2-style: effectiveFrom + effectiveTo. Calculation cron
// resolves the active setting for `now` and computes periodStart/periodEnd
// based on cycleStartDay.
model SalaryPeriodSetting {
  id            String    @id @default(uuid())
  companyId     Int
  cycleStartDay Int // 1..28
  effectiveFrom DateTime
  effectiveTo   DateTime?
  changedById   Int?
  changedBy     User?     @relation("SalaryPeriodChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([companyId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

// Per-group lesson cancellation. Distinct from Holiday (company-wide) —
// cancels just one group's lesson on a specific date. When attendance was
// already taken, creating a cancellation atomically reverses each affected
// student's consumption and salary accrual.
model LessonCancellation {
  id            String   @id @default(uuid())
  groupId       String
  group         Group    @relation("LessonCancellationGroup", fields: [groupId], references: [id])
  date          DateTime @db.Date
  reason        String
  cancelledById Int
  cancelledBy   User     @relation("LessonCancelledBy", fields: [cancelledById], references: [id])
  companyId     Int
  createdAt     DateTime @default(now())

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LessonCancellationDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  attendances Attendance[]

  // The plain @@unique here keeps a hard guard for the common case. The
  // *active* uniqueness ("at most one un-deleted cancellation per
  // [groupId, date]") is enforced via a partial unique index added in the
  // raw SQL section of the migration so a soft-deleted cancellation does
  // not block re-creating one for the same lesson.
  @@index([groupId, date])
  @@index([date])
  @@index([companyId])
  @@index([deletedAt])
}

/// Per-lesson substitute-teacher override. When a row exists for
/// (groupId, date) with deletedAt = null, the billing service treats
/// `teacherIds` as the *full effective* roster for that lesson —
/// `Group.teachers` is ignored. Without an override row, billing falls
/// back to `Group.teachers` as before.
///
/// `teacherIds` is the complete list (not a delta), so multi-teacher
/// substitutions ("Botir + Karima → Aziz + Karima") store cleanly.
///
/// "At most one active override per (groupId, date)" is enforced via a
/// partial unique index in raw SQL of the migration so a soft-deleted
/// override doesn't block re-creating one.
model LessonTeacherOverride {
  id         String   @id @default(uuid())
  groupId    String
  group      Group    @relation("LessonTeacherOverrideGroup", fields: [groupId], references: [id])
  date       DateTime @db.Date
  teacherIds Int[]
  reason     String?
  setById    Int
  setBy      User     @relation("LessonTeacherOverrideSetBy", fields: [setById], references: [id])
  companyId  Int
  createdAt  DateTime @default(now())

  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?     @relation("LessonTeacherOverrideDeletedBy", fields: [deletedById], references: [id])

  @@index([groupId, date])
  @@index([date])
  @@index([companyId])
  @@index([deletedAt])
}

/// Per-(groupId, originalDate) lesson reschedule. The lesson originally
/// scheduled for `originalDate` is moved to `newDate`.
///
/// Effects:
///   - originalDate is treated like a cancelled lesson (no attendance
///     allowed; existing attendance there is reversed via cascade).
///   - newDate is treated like a regular lesson day even if it isn't
///     in `Group.exactDays` — the validator allows attendance on it.
///
/// Two partial unique indexes (raw SQL in migration):
///   - one active reschedule per (groupId, originalDate)
///   - one active reschedule per (groupId, newDate) — prevents two
///     moved lessons landing on the same destination day.
model LessonReschedule {
  id                 String   @id @default(uuid())
  groupId            String
  group              Group    @relation("LessonRescheduleGroup", fields: [groupId], references: [id])
  originalDate       DateTime @db.Date
  newDate            DateTime @db.Date
  // Optional per-lesson room/time override on the new date. When NULL,
  // the group's default room and times are used.
  newRoomId          String?
  newRoom            Room?    @relation("LessonRescheduleNewRoom", fields: [newRoomId], references: [id])
  newLessonStartTime String?
  newLessonEndTime   String?
  reason             String?
  scheduledById      Int
  scheduledBy        User     @relation("LessonRescheduleScheduledBy", fields: [scheduledById], references: [id])
  companyId          Int
  createdAt          DateTime @default(now())

  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?     @relation("LessonRescheduleDeletedBy", fields: [deletedById], references: [id])

  @@index([groupId, originalDate])
  @@index([groupId, newDate])
  @@index([companyId])
  @@index([deletedAt])
  @@index([newRoomId])
}

model SalaryAccrual {
  id              String         @id @default(uuid())
  userId          Int
  user            User           @relation("UserSalaryAccruals", fields: [userId], references: [id])
  studentId       Int
  student         Student        @relation("StudentSalaryAccruals", fields: [studentId], references: [id])
  groupId         String
  group           Group          @relation("GroupSalaryAccruals", fields: [groupId], references: [id])
  // Nullable for non-lesson accruals (e.g. BALANCE_WITHDRAWAL where the admin
  // manually credits a teacher for prepaid balance that wasn't consumed by a
  // real lesson). For real lessons, this is always set.
  attendanceId    String?
  lessonDate      DateTime       @db.Date
  amount          Int
  // Frozen per-lesson cost at write time. Future course price changes
  // won't retroactively rewrite this row, so audit/breakdown reports stay
  // correct even if the course price moves. 0 for legacy/pre-versioning rows.
  perLessonCost   Int            @default(0)
  // Center top-up marker (Faza 2, July 2026 full-deserved payroll). TRUE when
  // this accrual was funded by the CENTER at calculation time for a lesson the
  // student had NOT yet paid for (the "gap") — i.e. the teacher is paid their
  // full deserved salary now, and the center fronts the uncovered slice. When
  // the student later pays, retroactive billing's `createAccrual` upsert hits
  // the SAME natural-key row and flips this back to FALSE (recovered), so the
  // teacher is never paid twice. Ordinary student-covered accruals stay FALSE.
  isCenterTopUp   Boolean        @default(false)
  // STICKY companion to `isCenterTopUp`: TRUE whenever this row was EVER center-
  // funded, and NEVER cleared. `isCenterTopUp` flips to FALSE on recovery, losing
  // the history of "the center once fronted this"; this flag preserves it so the
  // center-advance report can compute advanced (Σ wasCenterTopUp), still-fronted
  // (Σ isCenterTopUp), and recovered (Σ wasCenterTopUp AND NOT isCenterTopUp).
  wasCenterTopUp  Boolean        @default(false)
  salaryPaymentId String?
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id])

  // Coverage link: accrual is only written when the corresponding lesson
  // deduction transaction exists (B.1). Null until backfilled or for legacy rows.
  deductionTransactionId String?
  deductionTransaction   Transaction? @relation("AccrualDeduction", fields: [deductionTransactionId], references: [id])

  // Which salary-config version was active when this accrual was written.
  // Powers granular breakdown ("this 6,000 came from a 30% rule active
  // 2026-01-01..2026-04-15"). Null for accruals predating versioning.
  salaryConfigVersionId String?
  salaryConfigVersion   EmployeeSalaryConfigVersion? @relation(fields: [salaryConfigVersionId], references: [id])

  // Reversal audit (set when an attendance is flipped away from PRESENT/LATE
  // or a lesson is cancelled after-the-fact). Reversed accruals are excluded
  // from salary calculation and labelled in the breakdown UI.
  reversedAt     DateTime?
  reversedById   Int?
  reversedBy     User?     @relation("SalaryAccrualReversedBy", fields: [reversedById], references: [id])
  reversalReason String?

  companyId Int
  createdAt DateTime @default(now())

  // Carry-over anchor. NULL = this accrual belongs to the salary period that
  // contains `lessonDate` (the default — unchanged behaviour). When SET, the
  // accrual is bucketed into THIS period instead, because `lessonDate` fell
  // inside an already APPROVED/PAID (closed) period when the accrual was first
  // written (e.g. a student paid late, after the teacher's payroll for that
  // month was already closed). `lessonDate` is preserved so the salary-config
  // RATE version and the breakdown display still reflect the real lesson date.
  // Written exactly ONCE (only in the upsert `create` branch) so re-running
  // retroactive billing never drifts the target period.
  creditPeriodDate DateTime?

  // attendanceId is part of the unique key so withdrawal-based accruals
  // (where attendanceId IS NULL) can stack within the same month — Postgres
  // treats NULLs as distinct in UNIQUE constraints. For lesson accruals,
  // attendanceId is always set, so the original "one accrual per
  // (user, student, group, lessonDate)" semantic is preserved.
  @@unique([userId, studentId, groupId, lessonDate, attendanceId])
  @@index([userId, salaryPaymentId])
  @@index([companyId])
  @@index([deductionTransactionId])
  @@index([salaryConfigVersionId])
  @@index([reversedAt])
}

model SalaryPayment {
  id          String              @id @default(uuid())
  userId      Int
  user        User                @relation("UserSalaryPayments", fields: [userId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  amount      Int
  status      SalaryPaymentStatus @default(CALCULATED)
  paidAt      DateTime?
  paidById    Int?
  paidBy      User?               @relation("SalaryPaidBy", fields: [paidById], references: [id])
  note        String?
  companyId   Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  transactions    Transaction[]
  accruals        SalaryAccrual[]
  settledExpenses Expense[]       @relation("ExpenseSettledBy")

  @@index([userId])
  @@index([companyId, periodEnd])
  @@index([status])
}

model Refund {
  id               String         @id @default(uuid())
  studentId        Int
  student          Student        @relation(fields: [studentId], references: [id])
  // contractId is kept for legacy refunds that were tied to a Contract row.
  // New refunds are scoped per Enrollment instead — Contract is optional in
  // this system and most active students never have one.
  contractId       String?
  contract         Contract?      @relation(fields: [contractId], references: [id])
  enrollmentId     String?
  enrollment       Enrollment?    @relation(fields: [enrollmentId], references: [id])
  requestedAmount  Int
  approvedAmount   Int?
  lessonsCompleted Int
  totalLessons     Int
  deductions       Json?
  status           RefundStatus   @default(REQUESTED)
  refundMethod     PaymentMethod?
  reason           String?
  processedById    Int?
  processedBy      User?          @relation("RefundProcessedBy", fields: [processedById], references: [id])
  processedAt      DateTime?
  dueDate          DateTime?
  companyId        Int
  receiptCode      String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transactions Transaction[]

  @@index([studentId])
  @@index([contractId])
  @@index([enrollmentId])
  @@index([companyId])
  @@index([status])
}

model Expense {
  id            String               @id @default(uuid())
  category      ExpenseCategory
  paymentMethod ExpensePaymentMethod @default(CASH)
  amount        Int
  description   String
  date          DateTime             @db.Date
  branchId      Int
  receiptUrl    String?
  createdById   Int
  createdBy     User                 @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  // Optional link to an employee — used by TEACHER_ADVANCE to bind the
  // advance to the recipient so it can be netted against future salary.
  relatedUserId Int?
  relatedUser   User? @relation("ExpenseRelatedUser", fields: [relatedUserId], references: [id])

  // Settlement link: when a TEACHER_ADVANCE is netted out of a salary run,
  // this points at the SalaryPayment that absorbed it so the next run
  // skips it. NULL means "still outstanding."
  settledBySalaryPaymentId String?
  settledBySalaryPayment   SalaryPayment? @relation("ExpenseSettledBy", fields: [settledBySalaryPaymentId], references: [id])

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  transactions Transaction[]

  @@index([companyId, date])
  @@index([category])
  @@index([deletedAt])
  @@index([relatedUserId])
  @@index([branchId])
}

// ===== PAYMENT GATEWAY EVENT LOG =====

// Raw webhook payload log for Payme/Click/Uzum. Written before any payment
// processing so we can debug, dispute, replay or detect duplicates regardless
// of whether the payload was eventually accepted.
model PaymentGatewayEvent {
  id             String        @id @default(uuid())
  companyId      Int
  provider       PaymentMethod
  externalId     String
  eventType      String
  payload        Json
  signatureValid Boolean       @default(false)
  processed      Boolean       @default(false)
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime      @default(now())

  @@index([companyId, provider, createdAt])
  @@index([externalId])
  @@index([processed])
}

// ===== PAYME TRANSACTION =====

// Stores Payme-specific transaction lifecycle state. A PaymeTransaction is
// created on CreateTransaction (state=1) and linked to an ERP Payment only
// when PerformTransaction succeeds (state=2). Cancelled/refunded transactions
// are kept for audit and GetStatement reconciliation.
model PaymeTransaction {
  id          String @id @default(uuid())
  paymeId     String // 24-char Paycom transaction ID
  paymeTime   BigInt // Paycom-sent creation timestamp (ms)
  amount      Int // amount in tiyin (Paycom native)
  amountInSom Int // amount / 100 — for ERP use
  state       Int    @default(1) // 1=created, 2=performed, -1=cancelled, -2=refunded
  reason      Int? // cancellation reason (1-6)

  studentId Int // paying student

  createTime  BigInt // our creation timestamp (ms)
  performTime BigInt? // when PerformTransaction was called (ms)
  cancelTime  BigInt? // when CancelTransaction was called (ms)

  paymentId String? @unique // FK to Payment.id (set on state=2)

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymeId, companyId], name: "unique_payme_transaction")
  @@index([companyId, createTime])
  @@index([studentId])
  @@index([state])
}

// ===== CLICK TRANSACTION =====

// Stores Click-specific two-phase transaction lifecycle state. A ClickTransaction
// is created on Prepare (status=1) and linked to an ERP Payment only when
// Complete succeeds (status=2). Cancelled transactions are kept for audit.
model ClickTransaction {
  id            String  @id @default(uuid())
  clickTransId  BigInt // click_trans_id from Click
  clickPaydocId BigInt // click_paydoc_id (payment number in SMS)
  amount        Float // amount in so'm (N.NN format from Click)
  amountInSom   Int // truncated integer for ERP use
  status        Int     @default(0) // 0=pending, 1=prepared, 2=completed, -1=cancelled
  error         Int     @default(0) // Click error code
  errorNote     String? // Click error description

  studentId Int // merchant_trans_id = studentId

  prepareTime  DateTime? // when Prepare was called
  completeTime DateTime? // when Complete was called

  paymentId String? @unique // FK to Payment.id (set on complete)

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clickTransId, companyId], name: "unique_click_transaction")
  @@index([companyId, createdAt])
  @@index([studentId])
  @@index([status])
}

// ===== PAYMENT GATEWAY CONFIG =====

// Per-company merchant credentials for payment gateways. Replaces global
// env-based config so each company can have its own Payme/Click/Uzum merchant
// account. Credentials are encrypted at rest via application-level encryption.
model PaymentGatewayConfig {
  id            String        @id @default(uuid())
  companyId     Int
  provider      PaymentMethod // PAYME, CLICK, UZUM
  merchantId    String // merchant/kassa ID
  secretKey     String // production secret key
  secretKeyTest String? // sandbox/test secret key
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, provider])
}

// ===== PAYMENT INTENT =====

// Records the expected payment amount when a student initiates checkout via
// initPayment(). The webhook's CheckPerformTransaction verifies that the
// incoming amount matches a live intent for the student, closing the gap
// between "what the student started" and "what the gateway reports".
// Intents expire after 1 hour and are cleaned up by PaymeCronService.
model PaymentIntent {
  id          String        @id @default(uuid())
  studentId   Int
  companyId   Int
  provider    PaymentMethod // PAYME, CLICK
  amount      Int // expected amount in so'm
  amountTiyin Int // expected amount in tiyin (for Payme)
  expiresAt   DateTime // auto-expire (1 hour after creation)
  used        Boolean       @default(false) // set true once CheckPerformTransaction matches
  createdAt   DateTime      @default(now())

  @@index([studentId, companyId, provider, used])
}

// ===== FINANCE MODULE — CASH ACCOUNTS =====

// Real center liquidity. Each branch typically has a CASH (kassa) and a BANK
// account. Unlike Student/Teacher balances (tracked on the Transaction ledger),
// cash accounts track ACTUAL money in/out of the center. balance is the
// denormalized canonical figure; CashMovement is the append-only audit ledger.
model CashAccount {
  id        String          @id @default(uuid())
  name      String // "Asosiy kassa", "Bank hisobi", ...
  type      CashAccountType @default(CASH)
  branchId  Int // every account belongs to exactly one branch (D4)
  balance   Int             @default(0) // so'm
  isActive  Boolean         @default(true)
  companyId Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  movements CashMovement[]

  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
}

enum CashAccountType {
  CASH
  BANK
  CARD
}

// Append-only cash ledger. ONE row per real money movement. Cash Flow report
// and the Cash Balance KPI read from here. Corrections are reversals
// (reversedTransactionId + reversedAt), never destructive edits — same rule as
// the Transaction ledger. NOTE: only REAL cash in/out is recorded here
// (PAYMENT inflow, EXPENSE/SALARY_PAYMENT/REFUND outflow). LESSON_DEDUCTION /
// LESSON_CONSUMPTION are internal balance allocations and are NOT cash moves.
model CashMovement {
  id            String           @id @default(uuid())
  cashAccountId String
  cashAccount   CashAccount      @relation(fields: [cashAccountId], references: [id])
  type          CashMovementType
  amount        Int // signed: inflow > 0, outflow < 0
  balanceBefore Int
  balanceAfter  Int
  // Loose link to the source financial Transaction (no FK relation, mirrors the
  // companyId-as-scalar convention used across the finance schema).
  transactionId String?
  description   String?

  // Reversal markers — same pattern as Transaction.
  reversedTransactionId String?
  reversedAt            DateTime?

  performedById Int?
  branchId      Int?
  companyId     Int
  createdAt     DateTime @default(now())

  @@index([cashAccountId, createdAt])
  @@index([companyId, createdAt])
  @@index([type])
  @@index([reversedTransactionId])
}

enum CashMovementType {
  INFLOW
  OUTFLOW
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// ===== FINANCE MODULE — DISCOUNTS & SCHOLARSHIPS =====

// Auditable discount. Complements the legacy Student.discountPercent field by
// recording who/when/why/how-long. The effective discount applied at billing
// time is derived from active (date-bounded, non-deleted) rows.
model Discount {
  id          String       @id @default(uuid())
  studentId   Int
  student     Student      @relation(fields: [studentId], references: [id])
  type        DiscountType @default(PERCENTAGE)
  value       Int // percentage (0-100) or fixed amount in so'm
  startDate   DateTime
  endDate     DateTime?
  scope       Json? // { courseId?, groupId?, enrollmentId? } — null = all enrollments
  reason      String?
  createdById Int
  branchId    Int?
  companyId   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([studentId])
  @@index([companyId])
  @@index([deletedAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Persistent award (e.g. academic excellence). Like Discount but approval-gated.
model Scholarship {
  id           String          @id @default(uuid())
  studentId    Int
  student      Student         @relation(fields: [studentId], references: [id])
  type         ScholarshipType @default(PERCENTAGE)
  value        Int // percentage (0-100) or fixed amount in so'm
  startDate    DateTime
  endDate      DateTime?
  reason       String?
  approvedById Int?
  createdById  Int
  branchId     Int?
  companyId    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  @@index([studentId])
  @@index([companyId])
  @@index([deletedAt])
}

enum ScholarshipType {
  PERCENTAGE
  FIXED
}

// ===== FINANCE MODULE — INSTALLMENT PLANS =====

// Splits a Contract.totalAmount into scheduled installments. Payments are
// allocated to the oldest due installment as money lands.
model InstallmentPlan {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  totalAmount Int
  companyId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installments Installment[]

  @@index([contractId])
  @@index([companyId])
}

model Installment {
  id          String            @id @default(uuid())
  planId      String
  plan        InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequenceNum Int
  dueDate     DateTime
  amount      Int
  paidAmount  Int?
  paidAt      DateTime?
  status      InstallmentStatus @default(PENDING)
  companyId   Int

  @@unique([planId, sequenceNum])
  @@index([dueDate])
  @@index([status])
  @@index([companyId])
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ===== FINANCE MODULE — ALERTS =====

// Per-company configurable threshold rule. One row per (company, type).
model AlertRule {
  id         String    @id @default(uuid())
  type       AlertType
  threshold  Int
  windowDays Int?
  enabled    Boolean   @default(true)
  companyId  Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, type])
  @@index([enabled])
}

// A fired alert instance. Created by AlertsCronService; acknowledged by an admin.
model Alert {
  id               String        @id @default(uuid())
  type             AlertType
  severity         AlertSeverity @default(WARNING)
  message          String // Latin Uzbek
  data             Json? // { studentId, overdueAmount, daysOverdue, ... }
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  companyId        Int
  branchId         Int?
  createdAt        DateTime      @default(now())

  @@index([companyId])
  @@index([type])
  @@index([acknowledgedAt])
}

enum AlertType {
  OVERDUE_PAYMENT
  LOW_CASH_BALANCE
  UPCOMING_SALARY
  LARGE_EXPENSE
  ANOMALY
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Nightly snapshot of a company's key financial figures, written by the
/// 21:00 Telegram daily-report cron AFTER a successful send. Powers the
/// day-over-day debt ▲/▼ delta shown in the daily report ("bugun ▲ 1 200 000").
/// One row per company per Tashkent calendar day (upsert on same-day re-run);
/// the delta compares today's live figures against the most recent PRIOR day's
/// row, so a missing row (first run, or an off day) just means no delta shown.
/// One row per company per Tashkent day, plus one per branch. The centre's only
/// immutable daily record: every other figure can be recomputed later, this one
/// cannot — a day nobody wrote is gone.
model DailyFinancialSnapshot {
  id        Int      @id @default(autoincrement())
  companyId Int
  /// NULL = the company-wide row. A branch row carries its branch id. Nothing
  /// reads the branch rows yet; they are written from the start because the
  /// history they build cannot be reconstructed once the day has passed.
  branchId  Int?
  date      DateTime @db.Date

  totalDebt      Int @default(0)
  debtorCount    Int @default(0)
  activeStudents Int @default(0)
  mtdIncome      Int @default(0)

  /// «Oy oxiriga kutilyapti» as it stood that day (`getMonthlyExpectation`).
  expectedValue     Int?
  /// Value of the month's lessons held AND paid so far, that day.
  lessonsHeldValue  Int?
  /// Cash received this month that belongs to this month (the collection
  /// numerator). The percentage is NOT stored — it is derivable from these two,
  /// and a stored copy can drift from its own components.
  collectedForMonth Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Postgres treats NULLs in a UNIQUE index as distinct, so this does NOT stop
  /// a second company-wide row per day — the partial index
  /// `daily_snapshot_company_row_unique` (see the migration) does.
  @@unique([companyId, branchId, date])
  @@index([companyId, date])
}

/// Telegram kanal a'zolik gate'ining voronkasi — bitta qator = bitta Telegram
/// foydalanuvchisi. Gate yoqilganda (`TELEGRAM_REQUIRED_CHANNEL`) bot a'zo
/// bo'lmagan odamni to'sadi → `blockedAt`. Odam kanalga a'zo bo'lgach
/// "✅ Tekshirish" bosganda (yoki Telegram `chat_member` xabari kelganda) →
/// `joinedAt`. Keyin chiqib ketsa → `leftAt`; qayta kirsa `leftAt` NULL ga
/// qaytadi va `rejoinCount` oshadi.
///
/// ASOSIY METRIKA — "bot tufayli a'zo bo'lganlar":
///   blockedAt IS NOT NULL AND joinedAt IS NOT NULL
/// Ulardan hozir ham a'zo bo'lib turganlari (`leftAt IS NULL`) gate'ning CHIN
/// natijasi — bu ikki raqamning farqi soxta/vaqtinchalik a'zolikni ochib beradi.
///
/// `blockedAt IS NULL AND joinedAt IS NOT NULL` — botga kelganida allaqachon
/// a'zo bo'lgan odam: gate uni to'smagan, shuning uchun u ASOSIY metrikaga
/// kirmaydi (uni biz jalb qilmaganmiz).
///
/// Yozuv hajmi ataylab kichik: har xabarda EMAS, odam boshiga umr bo'yi ~2–3
/// marta yoziladi, shuning uchun bot trafigi bazaga sezilarli yuk bermaydi.
///
/// `telegramUserId` — `Student.telegramChatId` bilan bir xil turda (String), shu
/// sababli "bu odam bizning o'quvchimizmi?" degan solishtiruv to'g'ridan-to'g'ri
/// ishlaydi.
model TelegramChannelGateEvent {
  id             Int       @id @default(autoincrement())
  companyId      Int
  telegramUserId String
  username       String?
  firstName      String?
  blockedAt      DateTime?
  joinedAt       DateTime?
  leftAt         DateTime?
  rejoinCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, telegramUserId])
  @@index([companyId, blockedAt])
  @@index([companyId, joinedAt])
  @@index([companyId, leftAt])
}
