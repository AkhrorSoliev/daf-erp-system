generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  FROZEN
  GRADUATED
  EXPELLED
  ARCHIVED
  PROSPECT // Mock-only registrant who hasn't enrolled in a real course/group
}

enum SmsMessageType {
  AUTO
  MANUAL
}

enum SmsMessageStatus {
  SENT
  FAILED
}

enum GroupStatus {
  FORMING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
  ARCHIVED
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  FROZEN
  COMPLETED
  DROPPED
  TRANSFERRED
}

enum ExitType {
  GROUP_REMOVAL
  FREEZE
  EXPEL
  INACTIVE
  ARCHIVE
}

enum HolidayStatus {
  ACTIVE
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum EntityAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  RESTORE
}

enum AssigneeStatus {
  PENDING
  SEEN
  DONE
}

enum NotificationType {
  COMMENT
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DELETED
  TASK_UPDATED
  TASK_REMINDER
  SYSTEM
  LESSON_STARTED
  ATTENDANCE_ADMIN_ALERT
  ATTENDANCE_TEACHER_WARNING
  ATTENDANCE_MISSING_TEACHER
  ATTENDANCE_MISSING_ADMIN
  ATTENDANCE_COMPLETED
  LESSON_RESCHEDULED
  LESSON_CANCELLED
  PAYMENT_PROMISE_OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AiUseCaseType {
  STUDENT_CHAT
  STATISTICS
  VOCABULARY
  TEST_GENERATION
}

// ===== FINANCIAL SYSTEM ENUMS =====

enum PaymentMethod {
  CASH
  PAYME
  CLICK
  UZUM
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  REVERSED
}

enum TransactionType {
  PAYMENT
  LESSON_DEDUCTION
  LESSON_CONSUMPTION
  INITIAL_BALANCE
  REFUND
  SALARY_ACCRUAL
  SALARY_PAYMENT
  EXPENSE
  ADJUSTMENT
  TAX
  BALANCE_WITHDRAWAL
  DISCOUNT_ADJUSTMENT
  MOCK_EXAM_FEE
  DEBT_WRITE_OFF
}

enum LessonDeductionMode {
  FULL_CYCLE
  PARTIAL
  SINGLE_UNCOVERED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SalaryType {
  PERCENTAGE
  FIXED_PER_STUDENT
  FIXED_MONTHLY
}

enum SalaryPaymentStatus {
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  TEACHER_ADVANCE
  EQUIPMENT
  MAINTENANCE
  TAXES
  OTHER
}

// Classifies what an incoming Payment is FOR (revenue stream). NULL on legacy
// rows is treated as TUITION by reports. Drives revenue-by-type analytics.
enum RevenueType {
  TUITION
  REGISTRATION_FEE
  CERTIFICATE_FEE
  MATERIAL_SALE
  MOCK_EXAM_FEE
  OTHER
}

enum ExpensePaymentMethod {
  CASH
  CARD
}

enum PaymentSource {
  ADMIN_MANUAL
  STUDENT_PORTAL
  GATEWAY_WEBHOOK
  MANUAL_ATTACH
}

model Role {
  id   Int    @id
  name String @unique

  users UserRole[]
}

model User {
  id             Int        @id @default(autoincrement())
  firstName      String
  lastName       String
  phone          String?
  photo          String?
  gender         Gender?
  balance        Int        @default(0)
  login          String?
  password       String?
  isActive       Boolean    @default(true)
  status         UserStatus @default(ACTIVE)
  telegramChatId String?
  companyId      Int
  company        Company    @relation(fields: [companyId], references: [id])
  mainBranch     Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("DeletedByUser", fields: [deletedById], references: [id])
  deletedUsers    User[]    @relation("DeletedByUser")
  deletionBatchId String?

  roles         UserRole[]
  branches      UserBranch[]
  groups        Group[]        @relation("StudentGroups")
  groupTeachers GroupTeacher[] @relation("GroupTeachers")

  deletedBranches                  Branch[]                   @relation("BranchDeletedBy")
  deletedRooms                     Room[]                     @relation("RoomDeletedBy")
  deletedCourses                   Course[]                   @relation("CourseDeletedBy")
  deletedStudents                  Student[]                  @relation("StudentDeletedBy")
  deletedLeads                     Lead[]                     @relation("LeadDeletedBy")
  calledLeads                      Lead[]                     @relation("LeadCalledBy")
  deletedLeadColumns               LeadColumn[]               @relation("LeadColumnDeletedBy")
  deletedLeadSections              LeadSection[]              @relation("LeadSectionDeletedBy")
  deletedLeadSources               LeadSource[]               @relation("LeadSourceDeletedBy")
  createdCustomForms               CustomForm[]               @relation("CustomFormCreatedBy")
  deletedCustomForms               CustomForm[]               @relation("CustomFormDeletedBy")
  createdMockExamSections          MockExamSection[]          @relation("MockExamSectionCreatedBy")
  deletedMockExamSections          MockExamSection[]          @relation("MockExamSectionDeletedBy")
  createdMockExams                 MockExam[]                 @relation("MockExamCreatedBy")
  deletedMockExams                 MockExam[]                 @relation("MockExamDeletedBy")
  announcedMockExams               MockExam[]                 @relation("MockExamAnnouncedBy")
  deletedGroups                    Group[]                    @relation("GroupDeletedBy")
  deletedEnrollments               Enrollment[]               @relation("EnrollmentDeletedBy")
  deletedHolidays                  Holiday[]                  @relation("HolidayDeletedBy")
  createdGroupHolidayExtensions    GroupHolidayExtension[]    @relation("GroupHolidayExtensionCreatedBy")
  deletedStudentExitReasons        StudentExitReason[]        @relation("StudentExitReasonDeletedBy")
  deletedGroupTeacherChangeReasons GroupTeacherChangeReason[] @relation("GroupTeacherChangeReasonDeletedBy")
  deletedEnrollmentTransferReasons EnrollmentTransferReason[] @relation("EnrollmentTransferReasonDeletedBy")
  statusChanges                    StatusHistory[]            @relation("StatusChangedBy")
  entityChanges                    EntityHistory[]            @relation("EntityHistoryChangedBy")
  comments                         Comment[]                  @relation("CommentAuthor")
  commentAssignees                 CommentAssignee[]          @relation("CommentAssignees")
  notifications                    Notification[]             @relation("UserNotifications")
  pushSubscriptions                PushSubscription[]         @relation("UserPushSubscriptions")
  deviceTokens                     DeviceToken[]              @relation("UserDeviceTokens")
  sentSmsMessages                  SmsMessage[]               @relation("SmsSender")
  markedAttendances                Attendance[]               @relation("AttendanceMarkedBy")
  student                          Student?                   @relation("StudentUser")
  aiConversations                  AiConversation[]           @relation("UserAiConversations")

  // Financial relations (employee salary — works for all roles)
  salaryConfigs       EmployeeSalaryConfig[] @relation("UserSalaryConfigs")
  salaryPayments      SalaryPayment[]        @relation("UserSalaryPayments")
  salaryAccruals      SalaryAccrual[]        @relation("UserSalaryAccruals")
  teacherTransactions Transaction[]          @relation("TeacherTransactions")

  // Financial relations (operator)
  receivedPayments      Payment[]       @relation("PaymentReceivedBy")
  performedTransactions Transaction[]   @relation("TransactionPerformedBy")
  reversedTransactions  Transaction[]   @relation("TransactionReversedBy")
  processedRefunds      Refund[]        @relation("RefundProcessedBy")
  paidSalaries          SalaryPayment[] @relation("SalaryPaidBy")
  createdExpenses       Expense[]       @relation("ExpenseCreatedBy")
  deletedExpenses       Expense[]       @relation("ExpenseDeletedBy")
  relatedExpenses       Expense[]       @relation("ExpenseRelatedUser")
  deletedContracts      Contract[]      @relation("ContractDeletedBy")

  teacherHistoryChanges GroupTeacherHistory[] @relation("GroupTeacherHistoryChangedBy")

  // Activity report snapshot authorship
  roomCapacitySnapshots  RoomCapacitySnapshot[]  @relation("RoomCapacitySnapshotChangedBy")
  groupScheduleSnapshots GroupScheduleSnapshot[] @relation("GroupScheduleSnapshotChangedBy")
  coursePriceSnapshots   CoursePriceSnapshot[]   @relation("CoursePriceSnapshotChangedBy")
  enrollmentStateLogs    EnrollmentStateLog[]    @relation("EnrollmentStateLogChangedBy")

  // Financial v2 authorship (Faza 1 — version + period + cancellation + accrual reversal)
  salaryConfigVersionsAuthored  EmployeeSalaryConfigVersion[] @relation("SalaryConfigVersionChangedBy")
  salaryPeriodsAuthored         SalaryPeriodSetting[]         @relation("SalaryPeriodChangedBy")
  cancelledLessons              LessonCancellation[]          @relation("LessonCancelledBy")
  deletedLessonCancellations    LessonCancellation[]          @relation("LessonCancellationDeletedBy")
  setLessonTeacherOverrides     LessonTeacherOverride[]       @relation("LessonTeacherOverrideSetBy")
  deletedLessonTeacherOverrides LessonTeacherOverride[]       @relation("LessonTeacherOverrideDeletedBy")
  scheduledLessonReschedules    LessonReschedule[]            @relation("LessonRescheduleScheduledBy")
  deletedLessonReschedules      LessonReschedule[]            @relation("LessonRescheduleDeletedBy")
  plannedAbsences               PlannedAbsence[]              @relation("PlannedAbsenceCreatedBy")
  reversedSalaryAccruals        SalaryAccrual[]               @relation("SalaryAccrualReversedBy")
  createdPaymentPromises        PaymentPromise[]              @relation("PaymentPromiseCreatedBy")
  resolvedPaymentPromises       PaymentPromise[]              @relation("PaymentPromiseResolvedBy")
  callLogs                      CallLog[]                     @relation("CallLogCalledBy")

  approvedTelegramGroups TelegramGroup[] @relation("TelegramGroupApprovedBy")

  @@index([deletedAt])
  @@index([status])
}

model UserRole {
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserBranch {
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Branch {
  id                Int          @id @default(autoincrement())
  name              String
  address           String?
  phone             String?
  isActive          Boolean      @default(true)
  status            BranchStatus @default(ACTIVE)
  startOfWorkingDay String?
  endOfWorkingDay   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("BranchDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  users           UserBranch[]
  studentBranches StudentBranch[]
  rooms           Room[]
  groups          Group[]
  courses         Course[]
  telegramGroups  TelegramGroup[]
  leads           Lead[]
  leadColumns     LeadColumn[]
  mockExams       MockExam[]
  holidays        Holiday[]

  @@index([deletedAt])
  @@index([status])
}

model Room {
  id        String     @id @default(uuid())
  name      String
  capacity  Int?
  status    RoomStatus @default(ACTIVE)
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  companyId Int
  company   Company    @relation(fields: [companyId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("RoomDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groups            Group[]
  capacitySnapshots RoomCapacitySnapshot[]
  lessonReschedules LessonReschedule[]     @relation("LessonRescheduleNewRoom")

  @@index([deletedAt])
  @@index([status])
}

model Course {
  id                 String       @id @default(uuid())
  name               String
  description        String?
  price              Int
  lessonPaymentCount Int          @default(12)
  courseDuration     Int?
  lessonDuration     Int?
  lessonMinutes      Int?
  isActive           Boolean      @default(true)
  status             CourseStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  branchId  Int?
  branch    Branch? @relation(fields: [branchId], references: [id])
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("CourseDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groups         Group[]
  contracts      Contract[]
  priceSnapshots CoursePriceSnapshot[]

  @@index([deletedAt])
  @@index([status])
}

model Student {
  id              Int           @id @default(autoincrement())
  firstName       String
  lastName        String
  phone           String
  extraPhone      String?
  parentPhone     String?
  parentName      String?
  telegram        String?
  telegramChatId  String?
  gender          Gender?
  dateOfBirth     DateTime?
  photo           String?
  comment         String?
  balance         Int           @default(0)
  // Per-student discount (0–100) applied at lesson-billing time. Discount
  // shrinks ONLY the center's share — the LESSON_DEDUCTION metadata still
  // stores the full perLessonCost so SalaryAccrual computes the teacher's
  // pay from the un-discounted price.
  discountPercent Int           @default(0)
  placeOfStudy    String?
  address         String?
  passportSeries  String?
  isActive        Boolean       @default(true)
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  statusChangeReasonId String?
  statusExitReason     StudentExitReason? @relation(fields: [statusChangeReasonId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("StudentDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  userId Int?  @unique
  user   User? @relation("StudentUser", fields: [userId], references: [id])

  enrollments     Enrollment[]
  branches        StudentBranch[]
  smsMessages     SmsMessage[]
  attendances     Attendance[]
  plannedAbsences PlannedAbsence[]
  aiConversations AiConversation[] @relation("StudentAiConversations")

  mockExamParticipations MockExamParticipant[] @relation("StudentMockExamParticipations")

  // Financial relations
  payments        Payment[]
  transactions    Transaction[]    @relation("StudentTransactions")
  contracts       Contract[]
  refunds         Refund[]
  salaryAccruals  SalaryAccrual[]  @relation("StudentSalaryAccruals")
  paymentPromises PaymentPromise[]
  callLogs        CallLog[]
  discounts       Discount[]
  scholarships    Scholarship[]

  @@index([deletedAt])
  @@index([status])
}

model StudentBranch {
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([studentId, branchId])
}

model Lead {
  id          String     @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  gender      Gender?
  telegram    String?
  parentPhone String?
  parentName  String?
  status      String     @default("new")
  statusEnum  LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Board placement — column is derived via section.column
  sectionId String?
  section   LeadSection? @relation(fields: [sectionId], references: [id])
  order     Int          @default(0)

  // Lead source (where the lead came from)
  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  // Set to the Student id once the lead is converted into a real student.
  convertedStudentId Int?

  // Lightweight "call made" marker — set when an admin logs a call from the
  // lead detail drawer. Drives the phone icon on the board card. Cleared when
  // the admin un-marks it.
  calledAt   DateTime?
  calledById Int?
  calledBy   User?     @relation("LeadCalledBy", fields: [calledById], references: [id])

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  // Why the lead was lost. Set only when an admin deletes a lead directly
  // (delete = mark LOST): the lead is archived (deletedAt) with statusEnum=LOST
  // and this required reason. Section cascade-archival leaves it null (those
  // leads are merely archived, not deliberately "lost").
  lostReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  formSubmissions CustomFormSubmission[]

  // `Lead` carried NEITHER companyId NOR branchId — `getBoard()` was
  // `where: { deletedAt: null }`, i.e. every lead in the database. A Namangan
  // director saw, moved and deleted Fargona's leads.
  //
  // `branchId` is nullable ON PURPOSE, unlike Student/Group: a lead arrives
  // from a public form or a phone call BEFORE anyone knows which branch they
  // will study at. Null means "not yet assigned" and is visible to every
  // branch; conversion to a student is where the branch becomes mandatory
  // (`LeadsService.convert` already throws without one).
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  branchId  Int?
  branch    Branch? @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
  @@index([statusEnum])
  @@index([sectionId])
  @@index([sourceId])
}

// Leads board column. Two rows are seeded as fixed/system columns
// (systemKey "NEW" and "CONTACTED") and cannot be renamed, moved or deleted.
model LeadColumn {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  isSystem  Boolean  @default(false)
  systemKey String? // "NEW" | "CONTACTED" for the two fixed columns
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LeadColumnDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  // Board STRUCTURE is per branch, not per company.
  //
  // The first cut kept it company-level on the theory that duplicating columns
  // and sections would double the board without saying anything new. The
  // production data says otherwise: sections are named "A1 SPSH 15:00 Eldor",
  // "A1 DCHJ 10:00 Saida" — level, weekdays, hour and the TEACHER. Those are
  // forming groups, and a Fargona teacher's 15:00 slot means nothing in
  // Namangan. A shared board would force both branches to read each other's
  // timetable to find their own.
  //
  // The branch sits on the COLUMN only; a section's branch is its column's, and
  // a lead's is its section's column's. Denormalising it onto all three would
  // create two more copies to keep in sync, and `moveSection` would be free to
  // drift them apart. One owner, checked at the one place a section can change
  // columns.
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  sections LeadSection[]

  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
  @@index([order])
}

// Collapsible section inside a board column; holds the leads.
model LeadSection {
  id        String     @id @default(uuid())
  name      String
  order     Int        @default(0)
  columnId  String
  column    LeadColumn @relation(fields: [columnId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LeadSectionDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  leads       Lead[]
  customForms CustomForm[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([columnId])
}

// Managed reference list — where leads come from (Instagram, tavsiya, ...).
model LeadSource {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("LeadSourceDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  leads       Lead[]
  customForms CustomForm[]

  @@index([companyId])
  @@index([deletedAt])
}

// Public custom form (Google-Forms-like). Admin builds the field schema,
// gets a shareable public slug, and every submission lands as a Lead in the
// configured section.
model CustomForm {
  id             String  @id @default(uuid())
  slug           String  @unique
  title          String
  description    String?
  successMessage String?

  // Routing: every submission becomes a Lead in this section / source.
  sectionId String
  section   LeadSection @relation(fields: [sectionId], references: [id])
  sourceId  String?
  source    LeadSource? @relation(fields: [sourceId], references: [id])

  // Field schema (FormField[] — see DTO). Custom-typed entries beyond
  // firstName/lastName/phone are surfaced on the lead detail drawer.
  fields Json @default("[]")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdById Int?
  createdBy   User? @relation("CustomFormCreatedBy", fields: [createdById], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("CustomFormDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  submissions CustomFormSubmission[]

  @@index([slug])
  @@index([companyId])
  @@index([sectionId])
  @@index([deletedAt])
}

// One submission of a CustomForm. Stores the raw submitter payload alongside
// the Lead it produced — admins can inspect the original answers.
model CustomFormSubmission {
  id     String     @id @default(uuid())
  formId String
  form   CustomForm @relation(fields: [formId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  // { [fieldId]: value } — keyed by FormField.id from CustomForm.fields.
  data        Json
  ipAddress   String?
  userAgent   String?
  submittedAt DateTime @default(now())

  @@index([formId])
  @@index([leadId])
}

// =============================================================================
// Mock Exams (Mock imtihonlar)
// Lifecycle: DRAFT → REGISTRATION_OPEN → REGISTRATION_CLOSED → GRADING → ANNOUNCED → ARCHIVED
// Registration: Telegram-gated via bot deep-link (no public REST endpoint).
// Plan: docs/mock-exams-plan.md
// =============================================================================

enum MockExamStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  GRADING
  ANNOUNCED
  ARCHIVED
}

// Grouping of mock exams (e.g. "IELTS", "SAT", "DTM", "Ichki testlar").
model MockExamSection {
  id              String     @id @default(uuid())
  name            String
  order           Int        @default(0)
  color           String?
  createdById     Int?
  createdBy       User?      @relation("MockExamSectionCreatedBy", fields: [createdById], references: [id])
  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?      @relation("MockExamSectionDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  exams           MockExam[]

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([deletedAt])
  @@index([order])
}

// One concrete mock exam event (e.g. "IELTS Mock — Yanvar 2026").
// Holds its own registration form schema and Telegram deep-link payload.
model MockExam {
  id          String         @id @default(uuid())
  title       String
  description String?
  status      MockExamStatus @default(DRAFT)

  sectionId String
  section   MockExamSection @relation(fields: [sectionId], references: [id])

  examDate              DateTime?
  registrationDeadline  DateTime?
  durationMinutes       Int?
  maxScore              Float     @default(100)
  passingScore          Float?
  // Mock fee (so'm). 0 = bepul. Auto-deducted from Student.balance when
  // payment lands or balance becomes sufficient (MockExamBillingService).
  price                 Int       @default(0)
  // Discounted mock fee for real DaF students (so'm). NULL = DaF students
  // pay the full `price`. Applied when a registrant is matched to a Student
  // (by Telegram chat or phone) at registration time. Full-price display
  // (list, summary) still uses `price`; only the per-participant charged
  // amount switches to this via `resolveParticipantFee`.
  studentPrice          Int?
  // CEFR levels this exam offers (e.g. ["A1","A2","B1"]). Empty = no level
  // step. The bot shows these as inline buttons; the participant picks one.
  offeredLevels         String[]  @default([])
  // Time slots offered on `examDate` as "HH:mm" strings (e.g.
  // ["10:00","14:00"]). Empty / single = no time-choice step in the bot.
  // When more than one, the bot shows them as inline buttons and the
  // participant picks one (stored on MockExamParticipant.examTime).
  examTimes             String[]  @default([])
  // Cached results PDF — regenerated on announce or any score edit.
  resultsPdfFileKey     String?
  resultsPdfGeneratedAt DateTime?

  // Form field schema (FormFieldShape[] — same shape as CustomForm.fields).
  // Defaults firstName/lastName/phone are appended at render time; this stores extras.
  formFields Json @default("[]")

  // Telegram bot deep-link entry: t.me/<BOT>?start=mock_<botStartPayload>
  botStartPayload String @unique

  // Announcement
  announcedAt             DateTime?
  announcedById           Int?
  announcedBy             User?     @relation("MockExamAnnouncedBy", fields: [announcedById], references: [id])
  announceMessageTemplate String?

  // Audit
  createdById     Int?
  createdBy       User?     @relation("MockExamCreatedBy", fields: [createdById], references: [id])
  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("MockExamDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subjects     MockExamSubject[]
  participants MockExamParticipant[]

  // Mock exams carried no tenancy at all: `revenueSummary()` summed `paid: true`
  // across the WHOLE database and `update` did not even check `companyId`.
  //
  // `branchId` is where the exam is HELD — the bot's "Naqd (markazda)" line
  // could not say which markaz, and Namangan's mock revenue could not be told
  // apart from Fargona's. Nullable while the existing exams are backfilled.
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  branchId  Int?
  branch    Branch? @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([sectionId, status])
  @@index([deletedAt])
  @@index([registrationDeadline])
  @@index([status])
}

// Sub-sections within an exam (e.g. IELTS → Reading / Writing / Listening / Speaking).
model MockExamSubject {
  id           String                 @id @default(uuid())
  examId       String
  exam         MockExam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  name         String
  maxScore     Float
  // Optional per-subject pass threshold. When set, the score-entry UI and
  // PDF mark this subject as passed when participant's score >= passingScore.
  // For Goethe B1+ format each section has its own pass bar (typically 60/100).
  passingScore Float?
  order        Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  scores       MockExamSubjectScore[]

  @@index([examId])
}

// A registered participant in a mock exam. Each registration ties the
// participant to a Telegram chat (telegramChatId) so the result can be
// delivered back via the bot. May optionally be linked to an existing Student
// (manual conversion, mirroring the Lead → Student flow).
model MockExamParticipant {
  id     String   @id @default(uuid())
  examId String
  exam   MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Telegram identity — set when the participant registered via the bot
  // deep-link. Nullable because admins can also add participants manually
  // (no bot involvement, no chat id).
  telegramChatId    String?
  telegramUsername  String?
  telegramFirstName String?
  telegramLastName  String?

  // Form payload — what the participant typed when registering.
  firstName String
  lastName  String
  phone     String
  formData  Json   @default("{}")

  // CEFR level the participant chose (when the exam offers levels). Null
  // when the exam has no offered levels or for legacy rows.
  level String?

  // The exam time slot ("HH:mm") the participant chose, when the exam
  // offers multiple times. Null when the exam has a single time / none.
  examTime String?

  // The mock fee locked in for THIS registration (so'm), after any DaF
  // discount. Set at registration from the exam price + the resolved
  // studentId. Billing (balance auto-deduct), the gateway amount-match,
  // the payment deep-link, and the revenue summary all read this so a
  // later price edit or a discounted DaF payer never drifts the amount
  // owed. Null on legacy rows (pre-feature) → callers fall back to
  // exam.price.
  feeAmount Int?

  // 5-digit public identifier. Drawn from the same Postgres sequence as
  // `Student.id` (`Student_id_seq`) so values never collide. If the
  // participant is a real DaF student, publicId equals their Student.id
  // (reused across every mock they sign up for); for outsiders, a fresh
  // sequence value is allocated per registration. The same number is used
  // as the Click/Payme account id when paying for this mock, and (if
  // later converted) becomes the new Student.id.
  //
  // Uniqueness is enforced per-exam via `@@unique([examId, publicId])` —
  // a DaF student must be able to register for multiple exams reusing the
  // same publicId. Outsider publicIds never repeat (allocated from the
  // sequence) so the gateway-resolver lookup by publicId alone is still
  // unambiguous for the gateway-paying audience.
  publicId Int

  // Optional link to a real DaF student. Set when the participant is a
  // known DaF student at registration time, OR when an admin later
  // converts the (outside) participant to a student via the participants
  // tab. Mock results stay attached even after deletion via SetNull.
  studentId     Int?
  student       Student?  @relation("StudentMockExamParticipations", fields: [studentId], references: [id], onDelete: SetNull)
  convertedAt   DateTime?
  convertedById Int?

  registeredAt DateTime @default(now())

  // Payment for this specific mock exam. When a non-DaF participant pays
  // via Click/Payme using their publicId, `paid` flips to true directly
  // (no Transaction). DaF students pay through the normal balance flow;
  // a billing hook then flips this flag.
  paid   Boolean   @default(false)
  paidAt DateTime?

  // Result
  totalScore Float?
  percentage Float?
  passed     Boolean?
  feedback   String?
  rank       Int?
  gradedAt   DateTime?
  gradedById Int?

  // Announcement delivery tracking
  resultSentAt    DateTime?
  resultMessageId String?
  resultSendError String?

  // Audit
  deletedAt       DateTime?
  deletedById     Int?
  deletionBatchId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subjectScores       MockExamSubjectScore[]
  gatewayTransactions MockExamGatewayTransaction[]

  // One person can register for each MockExam only once — publicId is the
  // canonical identity (works whether they're a DaF student or not).
  //
  // The uniqueness is enforced by a PARTIAL unique index scoped to
  // `deletedAt IS NULL` (added as raw SQL in the migration), NOT by a plain
  // `@@unique`. A plain one counts soft-deleted rows too, so once an admin
  // removed a participant that person could never register for the same
  // exam again — the bot answered "Siz allaqachon ro'yxatga olingansiz"
  // forever. Removing someone must actually free their slot.
  // Denormalised from the exam so participant lists and revenue queries can be
  // filtered without a join on every call site.
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([examId, publicId])
  @@index([examId, deletedAt])
  @@index([studentId])
  @@index([telegramChatId])
  @@index([phone])
}

// Score for a single subject within a participant's exam result.
model MockExamSubjectScore {
  id            String              @id @default(uuid())
  participantId String
  subjectId     String
  participant   MockExamParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  subject       MockExamSubject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  score         Float
  feedback      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([participantId, subjectId])
  @@index([subjectId])
}

/// Gateway-state tracking for mock exam payments routed through Click /
/// Payme. Kept separate from `ClickTransaction` / `PaymeTransaction` (which
/// stay Student-only) so the two payment domains don't mix: a Student row
/// always reflects course-money flow, while this table is purely about
/// mock fees. State semantics mirror the gateway-specific tables to keep
/// the dispatcher simple — 1=prepared/created, 2=completed, -1=cancelled.
model MockExamGatewayTransaction {
  id                String              @id @default(uuid())
  provider          String // 'CLICK' or 'PAYME'
  externalId        String // Click click_trans_id / Payme paymeId
  mockParticipantId String
  mockParticipant   MockExamParticipant @relation(fields: [mockParticipantId], references: [id], onDelete: Restrict)

  // Money. `amount` keeps the gateway's native unit (tiyin for Payme,
  // so'm for Click); `amountInSom` is the canonical so'm value used for
  // matching against the mock exam price.
  amount      Float
  amountInSom Int

  state Int // 1=prepared/created, 2=completed, -1=cancelled, -2=refunded

  preparedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Gateway-specific extras
  clickPaydocId BigInt?
  paymeTime     BigInt? // Payme's "time" field (epoch ms)

  // Error / cancel tracking
  error     Int?
  errorNote String?
  reason    Int? // Payme cancel reason code

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([provider, externalId, companyId])
  @@index([mockParticipantId])
  @@index([state])
  @@index([createdAt])
  @@index([companyId])
}

model Group {
  id              String      @id @default(uuid())
  name            String
  groupNumber     Int?
  level           String?
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id])
  branchId        Int
  branch          Branch      @relation(fields: [branchId], references: [id])
  roomId          String?
  room            Room?       @relation(fields: [roomId], references: [id])
  companyId       Int
  company         Company     @relation(fields: [companyId], references: [id])
  days            String?
  exactDays       String[]
  lessonStartTime String?
  lessonEndTime   String?
  lessonMinutes   Int?
  status          Int         @default(2)
  statusEnum      GroupStatus @default(FORMING)
  comment         String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("GroupDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  teachers       GroupTeacher[]
  teacherHistory GroupTeacherHistory[]
  students       User[]                @relation("StudentGroups")
  enrollments    Enrollment[]
  attendances    Attendance[]

  // Financial relations
  contracts      Contract[]
  salaryConfigs  EmployeeSalaryConfig[]
  salaryAccruals SalaryAccrual[]        @relation("GroupSalaryAccruals")

  scheduleSnapshots      GroupScheduleSnapshot[]
  lessonCancellations    LessonCancellation[]    @relation("LessonCancellationGroup")
  lessonTeacherOverrides LessonTeacherOverride[] @relation("LessonTeacherOverrideGroup")
  lessonReschedules      LessonReschedule[]      @relation("LessonRescheduleGroup")
  holidayExtensions      GroupHolidayExtension[]
