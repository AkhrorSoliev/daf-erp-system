model GroupTeacher {
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId Int
  teacher   User   @relation("GroupTeachers", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([groupId, teacherId])
}

model GroupTeacherHistory {
  id                   String                    @id @default(uuid())
  groupId              String
  group                Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  previousTeacherIds   Int[]
  newTeacherIds        Int[]
  changeType           GroupTeacherChangeType
  changeReason         String?
  changeReasonId       String?
  changeReasonRef      GroupTeacherChangeReason? @relation(fields: [changeReasonId], references: [id])
  triggeredByDismissal Boolean                   @default(false)
  changedById          Int?
  changedBy            User?                     @relation("GroupTeacherHistoryChangedBy", fields: [changedById], references: [id])
  createdAt            DateTime                  @default(now())

  @@index([groupId, createdAt])
  @@index([createdAt])
  @@index([changeReasonId])
}

enum GroupTeacherChangeType {
  ADDED
  REMOVED
  REPLACED
}

model Enrollment {
  id                      String           @id @default(uuid())
  studentId               Int
  student                 Student          @relation(fields: [studentId], references: [id])
  groupId                 String
  group                   Group            @relation(fields: [groupId], references: [id])
  status                  EnrollmentStatus @default(ACTIVE)
  // Lessons covered by an upfront LESSON_DEDUCTION but not yet consumed.
  // Each PRESENT/LATE attendance decrements this; refilled at cycle start
  // when balance allows. Unused prepaid is refunded to balance on
  // DROPPED/TRANSFERRED so money doesn't stay locked to a closed enrollment.
  prepaidLessonsRemaining Int              @default(0)
  // Where this enrollment stands inside the current billing cycle, 0-based.
  //
  // Needed only by the lesson-by-lesson path a debtor is billed on: there is no
  // prepaid batch there, so nothing else records that the next lesson is the
  // twelfth and must settle the cycle's rounding remainder (see
  // `billing/lesson-price.ts`). Reset to 0 whenever a full/partial batch starts
  // a fresh cycle, and decremented when an attendance is flipped back.
  cycleLessonIndex        Int              @default(0)
  // Date this student starts appearing in attendance and being billed for
  // this group. Set explicitly during enroll (admin picks "from which lesson")
  // to support late joiners. Lessons before this date never bill or accrue
  // for this enrollment. Defaults to enrollment creation day on backfill.
  startDate               DateTime?
  createdAt               DateTime         @default(now())

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?
  transferredToId    String?

  departureReasonId String?
  departureReason   StudentExitReason? @relation(fields: [departureReasonId], references: [id])

  transferReasonId String?
  transferReason   EnrollmentTransferReason? @relation(fields: [transferReasonId], references: [id])

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("EnrollmentDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  stateLog EnrollmentStateLog[]
  refunds  Refund[]

  @@index([deletedAt])
  @@index([status])
  @@index([departureReasonId])
  @@index([transferReasonId])
}

model Holiday {
  id      String        @id @default(uuid())
  name    String
  date    DateTime
  endDate DateTime
  status  HolidayStatus @default(ACTIVE)

  statusChangedAt    DateTime?
  statusChangedById  Int?
  statusChangeReason String?

  deletedAt       DateTime?
  deletedById     Int?
  deletedBy       User?     @relation("HolidayDeletedBy", fields: [deletedById], references: [id])
  deletionBatchId String?

  groupExtensions GroupHolidayExtension[]

  // Holidays were GLOBAL ACROSS THE DATABASE — no company, no branch — while
  // driving attendance validation, billing, group end-date cascades, the daily
  // crons and the dashboard from ~15 call sites.
  //
  // `branchId` nullable is the meaningful state here, not a compromise: a null
  // holiday is a company-wide one (Navro'z, Mustaqillik kuni), which is what
  // almost every row is. A non-null one is a single branch closing — the case
  // that previously could not be expressed at all.
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  branchId  Int?
  branch    Branch? @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
  @@index([deletedAt, status, date, endDate])
}

model GroupHolidayExtension {
  id           String   @id @default(uuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  holidayId    String
  holiday      Holiday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  daysExtended Int
  oldEndDate   DateTime
  newEndDate   DateTime
  createdAt    DateTime @default(now())
  createdById  Int?
  createdBy    User?    @relation("GroupHolidayExtensionCreatedBy", fields: [createdById], references: [id])

  @@unique([groupId, holidayId])
  @@index([holidayId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Activity report snapshot tables (point-in-time history for /reports/activity)
//
// Pattern: Slowly Changing Dimension Type 2 (SCD2)
//   - validFrom: when this row started being effective
//   - validTo:   when it stopped (NULL = currently effective)
//   - On update, the old row gets validTo = now() and a new row is inserted.
//
// EnrollmentStateLog uses an event-log pattern instead, since enrollment
// status can transition multiple times (ACTIVE → FROZEN → ACTIVE). Each
// transition is appended as a new row; query MAX(transitionAt) <= date to
// reconstruct status at any given moment.
// ---------------------------------------------------------------------------

model RoomCapacitySnapshot {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  capacity    Int
  validFrom   DateTime
  validTo     DateTime?
  changedById Int?
  changedBy   User?     @relation("RoomCapacitySnapshotChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([roomId, validFrom])
  @@index([validFrom, validTo])
}

model GroupScheduleSnapshot {
  id              String    @id @default(uuid())
  groupId         String
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exactDays       String[]
  lessonStartTime String?
  lessonEndTime   String?
  courseId        String?
  validFrom       DateTime
  validTo         DateTime?
  changedById     Int?
  changedBy       User?     @relation("GroupScheduleSnapshotChangedBy", fields: [changedById], references: [id])
  createdAt       DateTime  @default(now())

  @@index([groupId, validFrom])
  @@index([validFrom, validTo])
}

model CoursePriceSnapshot {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  price       Int
  validFrom   DateTime
  validTo     DateTime?
  changedById Int?
  changedBy   User?     @relation("CoursePriceSnapshotChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([courseId, validFrom])
  @@index([validFrom, validTo])
}

model EnrollmentStateLog {
  id           String           @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       EnrollmentStatus
  transitionAt DateTime
  reason       String?
  changedById  Int?
  changedBy    User?            @relation("EnrollmentStateLogChangedBy", fields: [changedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([enrollmentId, transitionAt])
  @@index([transitionAt])
}

model StatusHistory {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  reason      String?
  changedById Int?
  changedBy   User?    @relation("StatusChangedBy", fields: [changedById], references: [id])
  companyId   Int?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([companyId])
}

model EntityHistory {
  id          String       @id @default(uuid())
  entityType  String
  entityId    String
  action      EntityAction
  oldValues   Json?
  newValues   Json?
  changedById Int?
  changedBy   User?        @relation("EntityHistoryChangedBy", fields: [changedById], references: [id])
  companyId   Int?
  createdAt   DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([companyId])
  @@index([createdAt])
}

model Company {
  id              Int       @id
  name            String
  subdomain       String?
  logo            String?
  phone           String?
  activatedTill   DateTime?
  customCss       String?
  customCssLead   String?
  leadSuccessText String?
  // Global reporting floor. When set, attendance stats / analytics reports do
  // not count or display data before this date — used at the May-1 cutover so
  // mid-April go-live noise never surfaces. NULL = no floor (count everything).
  systemStartDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users                       User[]
  branches                    Branch[]
  students                    Student[]
  courses                     Course[]
  rooms                       Room[]
  groups                      Group[]
  comments                    Comment[]
  attendances                 Attendance[]
  plannedAbsences             PlannedAbsence[]
  paymentPromises             PaymentPromise[]
  callLogs                    CallLog[]
  studentExitReasons          StudentExitReason[]
  groupTeacherChangeReasons   GroupTeacherChangeReason[]
  enrollmentTransferReasons   EnrollmentTransferReason[]
  telegramGroups              TelegramGroup[]
  customForms                 CustomForm[]
  mockExamGatewayTransactions MockExamGatewayTransaction[]
  leads                       Lead[]
  leadColumns                 LeadColumn[]
  leadSections                LeadSection[]
  leadSources                 LeadSource[]
  mockExamSections            MockExamSection[]
  mockExams                   MockExam[]
  mockExamParticipants        MockExamParticipant[]
  holidays                    Holiday[]
}

enum TelegramGroupStatus {
  PENDING
  APPROVED
  REJECTED
}

model TelegramGroup {
  id     String              @id @default(uuid())
  chatId BigInt              @unique
  title  String
  status TelegramGroupStatus @default(PENDING)

  // Filled by the bot when it is added to the group (my_chat_member event).
  addedByTelegramUserId BigInt?
  addedAt               DateTime @default(now())

  // Filled when an admin-panel CEO/BD approves the pending row — the group is
  // bound to their company at that moment and commands start working.
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  branchId     Int?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  approvedById Int?
  approvedBy   User?     @relation("TelegramGroupApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  /**
   * This group watches EVERY branch, deliberately.
   *
   * `branchId = null` used to carry two different meanings at once: "nobody has
   * assigned this group yet" (a mistake to fix) and "this is the org-wide
   * monitoring group" (correct, and permanent). Once branch events stopped
   * going to branch-less groups — which they had to, or one branch's payments
   * and attendance leaked into another's chat — the two became
   * indistinguishable, and the org-wide groups went quiet with no way to say
   * they were meant to be loud.
   *
   * So the intent is declared rather than inferred. `branchId` goes back to
   * meaning only "which branch", and stays fail-closed when unset. A group with
   * this flag receives every branch's operational events regardless of
   * `branchId`; it is additive, never a filter.
   *
   * The distinction is the same one this schema draws elsewhere between what a
   * record is VISIBLE to and what it is ATTRIBUTED to.
   */
  receivesAllBranches Boolean @default(false)

  isActive          Boolean   @default(true)
  lastDailyReportAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model StudentExitReason {
