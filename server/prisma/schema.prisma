generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

model Role {
  id    Int    @id
  name  String @unique

  users UserRole[]
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  phone          String?
  photo          String?
  gender         Gender?
  balance        Int       @default(0)
  login          String?   @unique
  password       String?
  isActive       Boolean   @default(true)
  telegramChatId String?   @unique
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id])
  mainBranch     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  roles         UserRole[]
  branches      UserBranch[]
  groups        Group[]        @relation("StudentGroups")
  teacherGroups Group[]        @relation("TeacherGroups")
}

model UserRole {
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserBranch {
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Branch {
  id        Int      @id
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  users     UserBranch[]
  rooms     Room[]
  groups    Group[]
}

model Room {
  id        String   @id @default(uuid())
  name      String
  capacity  Int?
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int
  duration    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  groups Group[]
}

model Student {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  phone          String
  extraPhone     String?
  parentPhone    String?
  parentName     String?
  telegram       String?
  telegramChatId String?  @unique
  gender         Gender?
  avatar         String?
  placeOfStudy   String?
  address        String?
  passportSeries String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments Enrollment[]
}

model Lead {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  gender      Gender?
  telegram    String?
  parentPhone String?
  parentName  String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id        String    @id @default(uuid())
  name      String
  courseId   String
  course    Course    @relation(fields: [courseId], references: [id])
  teacherId Int
  teacher   User      @relation("TeacherGroups", fields: [teacherId], references: [id])
  branchId  Int
  branch    Branch    @relation(fields: [branchId], references: [id])
  startDate DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students    User[]       @relation("StudentGroups")
  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, groupId])
}

model Holiday {
  id   String   @id @default(uuid())
  name String
  date DateTime
}

model Company {
  id                Int       @id
  name              String
  subdomain         String?
  logo              String?
  phone             String?
  activatedTill     DateTime?
  startOfWorkingDay String?
  endOfWorkingDay   String?
  customCss         String?
  customCssLead     String?
  leadSuccessText   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users    User[]
  branches Branch[]
  courses  Course[]
}
