{
  "unit": "u01",
  "dialoge": [
    {
      "id": "u01-d1",
      "section": "u01-s1",
      "titelDe": "Bist du Mia?",
      "titelUz": "Sen Miamisan?",
      "zeilen": [
        {
          "sprecher": "Jonas",
          "de": "Hallo! Bist du Mia?",
          "uz": "Salom! Sen Miamisan?"
        },
        {
          "sprecher": "Mia",
          "de": "Ja, ich bin Mia. Und du?",
          "uz": "Ha, men Miaman. Sen-chi?"
        },
        {
          "sprecher": "Jonas",
          "de": "Ich bin Jonas.",
          "uz": "Men Jonasman."
        },
        {
          "sprecher": "Mia",
          "de": "Wie geht es dir?",
          "uz": "Ahvoling qanday?"
        },
        {
          "sprecher": "Jonas",
          "de": "Gut. Und dir?",
          "uz": "Yaxshi. Sen-chi?"
        },
        {
          "sprecher": "Mia",
          "de": "Auch gut! Tschüss!",
          "uz": "Men ham yaxshi! Xayr!"
        },
        {
          "sprecher": "Jonas",
          "de": "Tschüss! Bis bald.",
          "uz": "Xayr! Tez orada ko'rishamiz."
        }
      ],
      "fragen": [
        {
          "frageDe": "Ist das Mia, Anna oder Claudia?",
          "frageUz": "Bu Mia, Anna yoki Claudiami?",
          "richtig": "Mia",
          "falsch": [
            "Anna",
            "Claudia"
          ]
        },
        {
          "frageDe": "Wie geht es Jonas?",
          "frageUz": "Jonasning ahvoli qanday?",
          "richtig": "gut",
          "falsch": [
            "nicht gut",
            "nicht sehr gut"
          ]
        }
      ]
    },
    {
      "id": "u01-d2",
      "section": "u01-s1",
      "titelDe": "Gute Nacht, Mia!",
      "titelUz": "Xayrli tun, Mia!",
      "zeilen": [
        {
          "sprecher": "Walter",
          "de": "Guten Abend, Mia!",
          "uz": "Xayrli kech, Mia!"
        },
        {
          "sprecher": "Mia",
          "de": "Guten Abend!",
          "uz": "Xayrli kech!"
        },
        {
          "sprecher": "Walter",
          "de": "Wie geht es dir?",
          "uz": "Ahvoling qanday?"
        },
        {
          "sprecher": "Mia",
          "de": "Gut! Und dir?",
          "uz": "Yaxshi! Sen-chi?"
        },
        {
          "sprecher": "Walter",
          "de": "Auch gut. Gute Nacht!",
          "uz": "Men ham yaxshi. Xayrli tun!"
        },
        {
          "sprecher": "Mia",
          "de": "Gute Nacht! Bis bald.",
          "uz": "Xayrli tun! Tez orada ko'rishamiz."
        }
      ],
      "fragen": [
        {
          "frageDe": "Ist das Mia oder Anna?",
          "frageUz": "Bu Mia mi yoki Anna?",
          "richtig": "Mia",
          "falsch": [
            "Anna",
            "Claudia"
          ]
        },
        {
          "frageDe": "Wie geht es Mia?",
          "frageUz": "Mianing ahvoli qanday?",
          "richtig": "gut",
          "falsch": [
            "nicht gut",
            "nicht sehr gut"
          ]
        }
      ]
    },
    {
      "id": "u01-d3",
      "section": "u01-s2",
      "titelDe": "Wie heißen Sie?",
      "titelUz": "Ismingiz nima?",
      "zeilen": [
        {
          "sprecher": "Claudia",
          "de": "Guten Tag!",
          "uz": "Xayrli kun!"
        },
        {
          "sprecher": "Markus",
          "de": "Guten Tag!",
          "uz": "Xayrli kun!"
        },
        {
          "sprecher": "Claudia",
          "de": "Wie heißen Sie?",
          "uz": "Ismingiz nima?"
        },
        {
          "sprecher": "Markus",
          "de": "Ich bin Markus. Und Sie?",
          "uz": "Men Markusman. Siz-chi?"
        },
        {
          "sprecher": "Claudia",
          "de": "Ich bin Claudia. Danke!",
          "uz": "Men Claudiaman. Rahmat!"
        },
        {
          "sprecher": "Markus",
          "de": "Auf Wiedersehen!",
          "uz": "Xayr!"
        },
        {
          "sprecher": "Claudia",
          "de": "Auf Wiedersehen!",
          "uz": "Xayr!"
        }
      ],
      "fragen": [
        {
          "frageDe": "Wie heißt der Herr?",
          "frageUz": "Janobning ismi nima?",
          "richtig": "Markus",
          "falsch": [
            "Jonas",
            "Thomas"
          ]
        },
        {
          "frageDe": "Wie heißt die Frau?",
          "frageUz": "Ayolning ismi nima?",
          "richtig": "Claudia",
          "falsch": [
            "Anna",
            "Mia"
          ]
        }
      ]
    },
    {
      "id": "u01-d4",
      "section": "u01-s3",
      "titelDe": "Woher kommst du?",
      "titelUz": "Sen qayerdansan?",
      "zeilen": [
        {
          "sprecher": "Lukas",
          "de": "Woher kommst du?",
          "uz": "Sen qayerdansan?"
        },
        {
          "sprecher": "Anna",
          "de": "Ich komme aus Deutschland. Und du, Lukas?",
          "uz": "Men Germaniyadanman. Sen-chi, Lukas?"
        },
        {
          "sprecher": "Lukas",
          "de": "Ich komme aus Usbekistan.",
          "uz": "Men O'zbekistondanman."
        },
        {
          "sprecher": "Anna",
          "de": "Wo wohnst du?",
          "uz": "Sen qayerda yashaysan?"
        },
        {
          "sprecher": "Lukas",
          "de": "Ich wohne in Deutschland. Und du?",
          "uz": "Men Germaniyada yashayman. Sen-chi?"
        },
        {
          "sprecher": "Anna",
          "de": "Ich wohne auch in Deutschland.",
          "uz": "Men ham Germaniyada yashayman."
        }
      ],
      "fragen": [
        {
          "frageDe": "Woher kommt Lukas?",
          "frageUz": "Lukas qayerdan?",
          "richtig": "aus Usbekistan",
          "falsch": [
            "aus Deutschland",
            "aus Usbekistan und aus Deutschland"
          ]
        },
        {
          "frageDe": "Wo wohnt Lukas?",
          "frageUz": "Lukas qayerda yashaydi?",
          "richtig": "in Deutschland",
          "falsch": [
            "in Usbekistan",
            "nicht in Deutschland"
          ]
        }
      ]
    },
    {
      "id": "u01-d5",
      "section": "u01-s4",
      "titelDe": "Null bis elf",
      "titelUz": "Nol dan o'n birgacha",
      "zeilen": [
        {
          "sprecher": "Sabine",
          "de": "Guten Tag! Hier, null, sieben, zwei, neun, vier, elf.",
          "uz": "Xayrli kun! Mana, nol, yetti, ikki, to'qqiz, to'rt, o'n bir."
        },
        {
          "sprecher": "Peter",
          "de": "Null, sieben, zwei, neun, fünf, elf?",
          "uz": "Nol, yetti, ikki, to'qqiz, besh, o'n birmi?"
        },
        {
          "sprecher": "Sabine",
          "de": "Nein, nicht fünf. Vier!",
          "uz": "Yo'q, besh emas. To'rt!"
        },
        {
          "sprecher": "Peter",
          "de": "Null, sieben, zwei, neun, vier, elf. Ja?",
          "uz": "Nol, yetti, ikki, to'qqiz, to'rt, o'n bir. Shundaymi?"
        },
        {
          "sprecher": "Sabine",
          "de": "Ja, gut! Danke!",
          "uz": "Ha, yaxshi! Rahmat!"
        },
        {
          "sprecher": "Peter",
          "de": "Bitte! Auf Wiedersehen!",
          "uz": "Marhamat! Xayr!"
        },
        {
          "sprecher": "Sabine",
          "de": "Auf Wiedersehen!",
          "uz": "Xayr!"
        }
      ],
      "fragen": [
        {
          "frageDe": "Ist es vier oder fünf?",
          "frageUz": "To'rtmi yoki besh?",
          "richtig": "vier",
          "falsch": [
            "fünf",
            "neun"
          ]
        },
        {
          "frageDe": "Null, sieben, zwei, neun, vier und?",
          "frageUz": "Nol, yetti, ikki, to'qqiz, to'rt va …?",
          "richtig": "elf",
          "falsch": [
            "eins",
            "drei"
          ]
        }
      ]
    },
    {
      "id": "u01-d6",
      "section": "u01-s5",
      "titelDe": "W wie Weber",
      "titelUz": "Weber so'zidagi 'W'",
      "zeilen": [
        {
          "sprecher": "Helga",
          "de": "Wie heißen Sie?",
          "uz": "Ismingiz nima?"
        },
        {
          "sprecher": "Anna",
          "de": "Ich bin Anna Weber.",
          "uz": "Men Anna Weberman."
        },
        {
          "sprecher": "Helga",
          "de": "Buchstabieren Sie bitte.",
          "uz": "Iltimos, harflab ayting."
        },
        {
          "sprecher": "Anna",
          "de": "W, E, B, E, R.",
          "tts": "Weh. Eh. Beh. Eh. Err.",
          "uz": "W, E, B, E, R."
        },
        {
          "sprecher": "Helga",
          "de": "Ist das V?",
          "tts": "Ist das Fau?",
          "uz": "Bu V mi?"
        },
        {
          "sprecher": "Anna",
          "de": "Nein, W! W wie Weber.",
          "tts": "Nein, Weh! Weh wie Weber.",
          "uz": "Yo'q, W! Weber dagi W."
        },
        {
          "sprecher": "Helga",
          "de": "Gut, danke!",
          "uz": "Yaxshi, rahmat!"
        }
      ],
      "fragen": [
        {
          "frageDe": "Wie heißt die Frau?",
          "frageUz": "Ayolning ismi nima?",
          "richtig": "Anna Weber",
          "falsch": [
            "Anna Neumann",
            "Mia Weber"
          ]
        },
        {
          "frageDe": "Ist das V oder W?",
          "frageUz": "Bu V mi yoki W?",
          "richtig": "W",
          "falsch": [
            "V",
            "Y"
          ]
        }
      ]
    }
  ]
