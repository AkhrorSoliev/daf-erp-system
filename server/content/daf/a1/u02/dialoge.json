    { "frageDe": "Was ist Markus? Lehrer oder Arzt?", "frageUz": "Markus kim? O'qituvchimi yoki shifokor?", "richtig": "Lehrer", "falsch": ["Arzt", "Chef"] }
   ]
  },
  {
