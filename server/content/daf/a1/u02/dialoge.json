     "sprecher": "Anna",
     "de": "Hallo, Julia! Wer ist das?",
     "uz": "Salom, Julia! Bu kim?"
    },
    {
     "sprecher": "Julia",
     "de": "Das ist Jonas, mein Freund.",
     "uz": "Bu Jonas, mening do'stim."
    },
    {
