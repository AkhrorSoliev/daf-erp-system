     "de": "Sie heißt Lena.",
     "uz": "Uning ismi Lena."
    },
    {
     "sprecher": "Anna",
     "de": "Und deine Eltern? Wo wohnen sie?",
     "uz": "Ota-onang-chi? Ular qayerda yashaydi?"
    },
    {
     "sprecher": "Jonas",
     "de": "Meine Eltern wohnen in Deutschland.",
     "uz": "Ota-onam Germaniyada yashaydi."
    }
   ],
   "fragen": [
    { "frageDe": "Wer ist Lena?", "frageUz": "Lena kim?", "richtig": "die Tochter", "falsch": ["die Schwester", "die Mutter"] },
