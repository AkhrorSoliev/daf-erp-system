   ]
  },
  {
   "id": "u02-d3",
   "section": "u02-s2",
   "titelDe": "Ich bin Oma!",
   "titelUz": "Men buviman!",
   "zeilen": [
    {
     "sprecher": "Claudia",
     "de": "Hallo, Thomas! Hast du Kinder?",
     "uz": "Salom, Thomas! Bolalaring bormi?"
    },
    {
     "sprecher": "Thomas",
     "de": "Ja, ich habe zwei Kinder. Und du?",
     "uz": "Ha, ikkita bolam bor. Sen-chi?"
    },
    {
     "sprecher": "Claudia",
     "de": "Ich habe eine Tochter. Sie ist dreißig.",
     "uz": "Bitta qizim bor. U o'ttiz yoshda."
    },
    {
     "sprecher": "Thomas",
     "de": "Hat deine Tochter auch Kinder?",
     "uz": "Qizingning ham bolalari bormi?"
    },
    {
     "sprecher": "Claudia",
     "de": "Ja, ein Kind. Ich bin Oma!",
     "uz": "Ha, bitta bolasi bor. Men buviman!"
    },
    {
     "sprecher": "Thomas",
     "de": "Das ist sehr gut!",
     "uz": "Bu juda yaxshi!"
    }
   ],
   "fragen": [
    { "frageDe": "Hat Thomas ein Kind, zwei Kinder oder drei Kinder?", "frageUz": "Thomasning bitta, ikkita yoki uchta bolasi bormi?", "richtig": "zwei Kinder", "falsch": ["ein Kind", "drei Kinder"] },
    { "frageDe": "Ist die Tochter zwanzig, dreißig oder vierzig?", "frageUz": "Qizi yigirma, o'ttiz yoki qirq yoshdami?", "richtig": "dreißig", "falsch": ["zwanzig", "vierzig"] }
   ]
  },
  {
   "id": "u02-d4",
   "section": "u02-s3",
   "titelDe": "Ich bin Ärztin",
   "titelUz": "Men shifokorman",
   "zeilen": [
    {
     "sprecher": "Markus",
     "de": "Hallo, Julia! Was ist dein Beruf?",
     "uz": "Salom, Julia! Kasbing nima?"
    },
    {
     "sprecher": "Julia",
     "de": "Ich bin Ärztin. Und du, Markus?",
     "uz": "Men shifokorman. Sen-chi, Markus?"
    },
    {
     "sprecher": "Markus",
     "de": "Ich bin Lehrer.",
     "uz": "Men o'qituvchiman."
    },
    {
     "sprecher": "Julia",
     "de": "Wo arbeitest du?",
     "uz": "Qayerda ishlaysan?"
    },
    {
     "sprecher": "Markus",
     "de": "Ich arbeite hier in der Schule.",
     "uz": "Shu yerda, maktabda ishlayman."
    },
    {
     "sprecher": "Julia",
     "de": "Mein Bruder ist auch Lehrer!",
     "uz": "Akam ham o'qituvchi!"
    }
   ],
   "fragen": [
    { "frageDe": "Was ist Julia?", "frageUz": "Julia kim bo'lib ishlaydi?", "richtig": "Ärztin", "falsch": ["Lehrerin", "Chef"] },
    { "frageDe": "Wo arbeitet Markus?", "frageUz": "Markus qayerda ishlaydi?", "richtig": "in der Schule", "falsch": ["in der Firma", "nicht hier"] }
   ]
  },
  {
   "id": "u02-d5",
   "section": "u02-s4",
   "titelDe": "Der Chef ist neu",
