    {
     "sprecher": "Julia",
     "de": "Nein, er studiert hier.",
     "uz": "Yo'q, u shu yerda o'qiydi."
    },
    {
     "sprecher": "Anna",
     "de": "Und du? Was machst du?",
     "uz": "Sen-chi? Nima bilan shug'ullanasan?"
    },
    {
     "sprecher": "Julia",
     "de": "Ich studiere auch. Wir lernen zusammen.",
     "uz": "Men ham o'qiyman. Birga o'qiymiz."
