   "section": "u02-s2",
   "titelDe": "Zwei Kinder",
   "titelUz": "Ikkita bola",
   "zeilen": [
    {
     "sprecher": "Claudia",
     "de": "Hast du Kinder?",
     "uz": "Bolalaring bormi?"
    },
    {
     "sprecher": "Thomas",
     "de": "Ja, ich habe zwei Kinder.",
     "uz": "Ha, mening ikkita bolam bor."
    },
    {
     "sprecher": "Claudia",
     "de": "Und dein Bruder?",
     "uz": "Akang-chi?"
    },
    {
     "sprecher": "Thomas",
     "de": "Er hat drei Kinder.",
     "uz": "Uning uchta bolasi bor."
    },
    {
     "sprecher": "Claudia",
     "de": "Und deine Oma?",
     "uz": "Buving-chi?"
    },
    {
     "sprecher": "Thomas",
     "de": "Meine Oma ist neunzig.",
     "uz": "Buvim to'qson yoshda."
    }
   ],
   "fragen": [
    { "frageDe": "Hat Thomas ein Kind, zwei Kinder oder drei Kinder?", "frageUz": "Thomasning bitta, ikkita yoki uchta bolasi bormi?", "richtig": "zwei Kinder", "falsch": ["ein Kind", "drei Kinder"] },
    { "frageDe": "Ist die Oma achtzig oder neunzig?", "frageUz": "Buvisi saksonmi yoki to'qson?", "richtig": "neunzig", "falsch": ["achtzig", "siebzig"] }
   ]
  },
  {
