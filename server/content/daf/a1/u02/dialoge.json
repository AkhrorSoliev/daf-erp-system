   "section": "u02-s1",
   "titelDe": "Meine Familie",
   "titelUz": "Mening oilam",
   "zeilen": [
    {
     "sprecher": "Mia",
     "de": "Ist das deine Familie?",
     "uz": "Bu sening oilangmi?"
    },
    {
     "sprecher": "Thomas",
     "de": "Ja, das ist meine Familie.",
     "uz": "Ha, bu mening oilam."
    },
    {
     "sprecher": "Mia",
     "de": "Wer ist das?",
     "uz": "Bu kim?"
    },
    {
     "sprecher": "Thomas",
     "de": "Das ist mein Vater.",
     "uz": "Bu mening otam."
    },
    {
     "sprecher": "Mia",
     "de": "Und das? Ist das deine Mutter?",
     "uz": "Bu-chi? Bu sening onangmi?"
    },
    {
     "sprecher": "Thomas",
     "de": "Ja, das ist meine Mutter.",
     "uz": "Ha, bu mening onam."
    }
   ],
   "fragen": [
    { "frageDe": "Ist das der Vater oder der Bruder?", "frageUz": "Bu otasimi yoki akasi?", "richtig": "der Vater", "falsch": ["der Bruder", "der Sohn"] },
    { "frageDe": "Wer ist das? Die Mutter, die Schwester oder die Oma?", "frageUz": "Bu kim? Ona, opa yoki buvi?", "richtig": "die Mutter", "falsch": ["die Schwester", "die Oma"] }
   ]
  },
  {
   "id": "u02-d2",
   "section": "u02-s1",
   "titelDe": "Meine Schwester",
   "titelUz": "Mening opam",
