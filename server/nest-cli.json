{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../assets/**/*",
        "outDir": "dist/assets",
        "watchAssets": false
      },
      {
        "include": "../content/**/*",
        "outDir": "dist/content",
        "watchAssets": false
      }
    ]
  }
}
