{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dafzentrum.uz/api",
        "EXPO_PUBLIC_TELEGRAM_BOT": "dafzentrum_bot"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dafzentrum.uz/api",
        "EXPO_PUBLIC_TELEGRAM_BOT": "dafzentrum_bot"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
